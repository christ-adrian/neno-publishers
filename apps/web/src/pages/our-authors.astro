---
import PersonCard from "../components/person-card.astro";
import Layout from "../layouts/Layout.astro";
import { AUTHORS_QUERY } from "../lib/queries";
import {
	getSanityClient,
	type SanityImage,
	sanityImageUrl,
} from "../lib/sanity";

interface Author {
	credentials: string | null;
	name: string;
	photo: SanityImage | null;
}

const wordSeparator = /\s+/u;

let authors: Author[] = [];
let unavailable = false;

try {
	authors = await getSanityClient().fetch<Author[]>(AUTHORS_QUERY);
} catch {
	unavailable = true;
	Astro.response.status = 503;
}

const emptyMessage = unavailable
	? "The author directory is temporarily unavailable. Please try again shortly."
	: "There are no authors in the directory yet.";
---

<Layout
	description="Meet the authors published by Neno Publishers."
	skipTo="main-content"
	title="Our Authors | Neno Publishers"
>
	<main class="author-directory" id="main-content">
		<header class="author-directory__header" data-enter>
			<h1>Our authors</h1>
			<p>Meet the people behind the books we publish.</p>
		</header>

		{authors.length > 0 ? (
			<ul aria-label="Author directory" class="author-directory__grid">
				{authors.map(({ credentials, name, photo }, index) => {
					const portrait = sanityImageUrl(photo, 400);
					const largePortrait = sanityImageUrl(photo, 800);
					const initials = name
						.trim()
						.split(wordSeparator)
						.slice(0, 2)
						.map((part) => Array.from(part)[0])
						.join("");
					return (
						<PersonCard
							initials={portrait ? undefined : initials}
							name={name}
							subtitle={credentials}
						>
							{portrait && (
								<img
									alt=""
									decoding="async"
									height="364"
									loading={index < 3 ? "eager" : "lazy"}
									sizes="(min-width: 82rem) 25.5rem, (min-width: 42rem) 32vw, 100vw"
									slot="portrait"
									src={portrait}
									srcset={
										largePortrait
											? `${portrait} 400w, ${largePortrait} 800w`
											: undefined
									}
									width="400"
								/>
							)}
						</PersonCard>
					);
				})}
			</ul>
		) : (
			<p class="author-directory__message">{emptyMessage}</p>
		)}
	</main>
</Layout>

<style>
	.author-directory {
		width: min(100% - 2 * var(--spacing-site-gutter), 78rem);
		padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem);
		margin-inline: auto;
	}

	.author-directory__header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 2rem;
		align-items: end;
		justify-content: space-between;
		padding-block-end: clamp(1.4rem, 3vw, 2.4rem);
		margin-block-end: clamp(1.65rem, 3.5vw, 3rem);
		border-block-end: 1px solid var(--color-border);
	}

	.author-directory__header h1 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(3rem, 7.4vw, 7.1rem);
		font-weight: 760;
		line-height: 0.95;
		color: var(--color-ink);
		word-spacing: 0.035em;
		letter-spacing: -0.068em;
		text-wrap: balance;
	}

	.author-directory__header p,
	.author-directory__message {
		max-width: 28ch;
		margin: 0;
		line-height: 1.65;
		color: var(--color-ink-muted);
	}

	.author-directory__grid {
		padding: 0;
		margin: 0;
		list-style: disc;
	}

	.author-directory__grid > li::marker {
		content: "";
	}

	.author-directory__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(0.75rem, 2vw, 1.35rem);
	}

	@media (min-width: 42rem) {
		.author-directory__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.author-directory__header {
			animation: author-directory-enter 260ms var(--ease-nav-settle) both;
		}

		@keyframes author-directory-enter {
			from {
				opacity: 0;
				transform: translateY(0.35rem);
			}
		}
	}
</style>
