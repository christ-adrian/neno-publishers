---
import ServicesPage from "../../components/our-services/services-page.astro";
import { services } from "../../components/our-services/content";
import Layout from "../../layouts/Layout.astro";

const service = services.find(({ slug }) => slug === Astro.params.service);
const title = service ? `${service.title} | Neno Publishers` : "Service not found | Neno Publishers";

if (!service) {
	Astro.response.status = 404;
}
---

<Layout title={title}>
	{service ? (
		<ServicesPage service={service} />
	) : (
		<main class="service-not-found">
			<h1>Service not found</h1>
			<p>The service you requested does not exist.</p>
			<a href="/our-services">Browse our services</a>
		</main>
	)}
</Layout>
