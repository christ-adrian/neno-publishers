---
import { PortableText } from "@portabletext/astro";
import BookCard from "../../components/our-books/book-card.astro";
import BookCover from "../../components/our-books/book-cover.astro";
import BookDescriptionHeading from "../../components/our-books/book-description-heading.astro";
import Layout from "../../layouts/Layout.astro";
import { bookCategories } from "../../lib/book-categories";
import { bookCoverUrl, getBook } from "../../lib/books";

let book: Awaited<ReturnType<typeof getBook>> = null;
let unavailable = false;

const slug = Astro.params.slug;
if (slug) {
	try {
		book = await getBook(slug);
	} catch {
		unavailable = true;
	}
}

if (!book) {
	Astro.response.status = unavailable ? 503 : 404;
}

const title = book?.title ?? (unavailable ? "Book temporarily unavailable" : "Book not found");
const authors = book?.authors.map(({ name }) => name).join(", ");
const category = bookCategories.find(({ value }) => value === book?.category);
const price = book?.priceKsh;
const priceLabel =
	typeof price === "number"
		? `KSh ${new Intl.NumberFormat("en-KE", { maximumFractionDigits: 2 }).format(price)}`
		: null;
const facts = book
	? [
			{ label: "Genre", value: category?.title ?? null },
			{ label: "Publication year", value: book.publishedYear },
			{ label: "Page count", value: book.pages },
			{ label: "ISBN", value: book.isbn },
			{ label: "Price", value: priceLabel },
		].filter(({ value }) => value !== null && value !== "")
	: [];
const cover = book?.coverImage ?? null;
const previewImage = bookCoverUrl(cover, 1200) ?? undefined;
const hasDescription = Boolean(book?.description?.length);
const headingComponents = {
	block: {
		h1: BookDescriptionHeading,
		h2: BookDescriptionHeading,
		h3: BookDescriptionHeading,
		h4: BookDescriptionHeading,
		h5: BookDescriptionHeading,
		h6: BookDescriptionHeading,
	},
};
---

<Layout description={book?.summary ?? undefined} image={previewImage} skipTo="main-content" title={`${title} | Neno Publishers`}>
	<main class="book-detail" id="main-content">
		<a class="catalog-link" href="/our-books"><span aria-hidden="true">←</span> All books</a>

		{book ? (
			<>
				<section aria-labelledby="book-title" class="book-feature" data-enter>
					<div class="book-feature__cover">
						<BookCover
							altText={cover?.alt || `Cover of ${book.title}`}
							cover={cover}
							fetchPriority="high"
							loading="eager"
							presentation="detail"
							sizes="(min-width: 69rem) 352px, (min-width: 50rem) 33vw, (min-width: 24rem) 232px, 64vw"
							title={book.title}
						/>
					</div>

					<div class="book-feature__copy">
						{authors && <p class="book-feature__author">By {authors}</p>}
						<h1 id="book-title">{title}</h1>
						{book.summary && <p class="book-feature__summary">{book.summary}</p>}
					</div>
				</section>

				{(hasDescription || facts.length > 0) && (
					<section aria-labelledby="book-description" class="book-information">
						<h2 id="book-description">About the book</h2>
						<div class:list={["book-information__content", { "book-information__content--split": hasDescription && facts.length > 0 }]}>
							{book.description?.length ? (
								<div class="book-information__prose">
									<PortableText components={headingComponents} value={book.description} />
								</div>
							) : null}
							{facts.length > 0 && (
								<dl class="book-information__facts">
									{facts.map(({ label, value }) => (
										<div><dt>{label}</dt><dd>{value}</dd></div>
									))}
								</dl>
							)}
						</div>
					</section>
				)}

				{book.otherBooks.length > 0 && (
					<section aria-labelledby="other-books" class="other-books">
						<header class="other-books__header">
							<h2 id="other-books">See other books</h2>
							<a class="catalog-link" href="/our-books">Browse the catalog <span aria-hidden="true">→</span></a>
						</header>
						<ul class="other-books__grid" role="list">
							{book.otherBooks.map((otherBook) => (
								<li><BookCard book={otherBook} heading="h3" /></li>
							))}
						</ul>
					</section>
				)}
			</>
		) : (
			<div class="book-detail__error">
				<h1>{title}</h1>
				<p>{unavailable ? "Please try again shortly." : "This title is no longer in the catalog."}</p>
			</div>
		)}
	</main>
</Layout>

<style>
	.book-detail {
		width: min(100% - 2 * var(--spacing-site-gutter), 78rem);
		margin-inline: auto;
		padding-block: clamp(1rem, 3vw, 2.25rem) clamp(4rem, 8vw, 7rem);
	}

	.catalog-link {
		display: inline-flex;
		gap: 0.55rem;
		align-items: center;
		min-block-size: 2.75rem;
		color: var(--color-brand-primary-dark);
		font-size: 0.925rem;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25em;
	}

	.catalog-link:hover { text-decoration-color: currentColor; }
	.catalog-link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

	.book-feature {
		position: relative;
		display: grid;
		gap: clamp(1.4rem, 4.6vw, 4rem);
		align-items: center;
		isolation: isolate;
		margin-block-start: 0.75rem;
		padding: clamp(1.35rem, 5vw, 4rem);
		color: var(--color-on-image);
	}

	.book-feature::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		content: "";
		background: var(--color-brand-primary-dark);
	}

	.book-feature__cover {
		width: min(100%, 14.5rem);
		margin-inline: auto;
	}

	.book-feature__cover :global(img) {
		filter: drop-shadow(0 0.9rem 1.15rem rgb(8 27 42 / 24%));
	}

	.book-feature__author {
		margin-block-end: 0.65rem;
		font-size: 0.95rem;
		font-weight: 650;
	}

	h1 {
		max-inline-size: 19ch;
		font-size: clamp(2.5rem, 5.5vw, 5rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 0.99;
		overflow-wrap: anywhere;
		text-wrap: balance;
	}

	.book-feature__summary {
		max-inline-size: 54ch;
		margin-block-start: 1.15rem;
		font-size: clamp(0.975rem, 1.4vw, 1.1rem);
		line-height: 1.65;
	}

	.book-information,
	.other-books {
		margin-block-start: clamp(3rem, 7vw, 5.25rem);
	}

	h2 {
		font-size: clamp(2.1rem, 4.5vw, 3.25rem);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.03;
	}

	.book-information__content {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: start;
		margin-block-start: 1.1rem;
	}

	.book-information__prose,
	.book-detail__error p {
		max-inline-size: 66ch;
		color: var(--color-ink-muted);
		line-height: 1.75;
	}

	.book-information__prose > :global(* + *) { margin-block-start: 0.85rem; }
	.book-information__prose :global(ul),
	.book-information__prose :global(ol) { padding-inline-start: 1.5rem; }
	.book-information__prose :global(ul) { list-style: disc; }
	.book-information__prose :global(ol) { list-style: decimal; }
	.book-information__prose :global(a) { color: var(--color-brand-primary-dark); text-decoration: underline; }

	.book-information__facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));
		gap: 0.9rem 1.25rem;
		margin: 0;
	}

	.book-information__facts > div {
		padding-block-start: 0.8rem;
		border-block-start: 1px solid var(--color-border);
	}

	.book-information__facts dt { color: var(--color-ink-muted); font-size: 0.875rem; }
	.book-information__facts dd { margin: 0.25rem 0 0; font-weight: 650; overflow-wrap: anywhere; }

	.other-books__header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		align-items: baseline;
		justify-content: space-between;
		margin-block-end: 1.35rem;
	}

	.other-books__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(0.9rem, 2vw, 1.65rem);
	}

	.book-detail__error { margin-block: 1rem; }
	.book-detail__error p { margin-block-start: 0.85rem; }

	@media (min-width: 24rem) {
		.other-books__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (min-width: 50rem) {
		.book-feature {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr);
			padding-inline-start: 0;
		}

		.book-feature::before { inset-inline-start: 15%; }
		.book-feature__cover { width: min(100%, 22rem); }

		.book-information__content--split {
			grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
		}

		.other-books__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}

	@media (prefers-reduced-motion: no-preference) {
		.book-feature {
			animation: book-feature-enter 250ms var(--ease-nav-settle) both;
		}

		@keyframes book-feature-enter {
			from { opacity: 0; transform: translateY(0.35rem); }
		}
	}
</style>
