---
import serviceRecords from "../../../../content/services.json";
import Layout from "../layouts/Layout.astro";

const requestedSubject = Astro.url.searchParams.get("service");
const serviceGroups = [
	{ label: "Publishing", value: "publishing" },
	{ label: "Printing", value: "printing" },
	{ label: "Advisory", value: "advisory" },
].map(({ label, value }) => ({
	label,
	services: serviceRecords
		.filter(({ category }) => category === value)
		.sort((left, right) => left.displayOrder - right.displayOrder),
	value,
}));

const selectedSubject =
	requestedSubject === "advisory" ||
	serviceRecords.some(({ slug }) => slug.current === requestedSubject)
		? requestedSubject
		: null;

const email = "info@nenopublishers.co.ke";
const mapSource =
	"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.924685058209!2d36.8958709!3d-1.2126887!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x182f3e24020aa02b%3A0xe0954857050ea563!2sBlessed%20House!5e0!3m2!1sen!2ske!4v1795757698885!5m2!1sen!2ske";
const directions =
	"https://www.google.com/maps/dir/?api=1&destination=Blessed+House%2C+Thika+Road%2C+Nairobi";
---

<Layout
	description="Contact Neno Publishers in Nairobi about your book or print project. Find our phone numbers, email, office location and enquiry form."
	skipTo="main-content"
	title="Contact Us | Neno Publishers"
>
	<main class="contact-page" id="main-content">
		<header class="contact-heading" data-enter>
			<h1>Get in touch</h1>
			<p>
				Talk to our Nairobi team about publishing, printing or getting advice on
				your book.
			</p>
		</header>

		<div class="contact-grid">
			<section aria-labelledby="contact-form-title" class="contact-form-panel">
				<h2 id="contact-form-title">Tell us about your project</h2>
				<contact-enquiry>
					<form method="post">
						<div class="contact-name-fields">
							<div class="contact-field">
								<label for="contact-first-name">First name</label>
								<input
									autocomplete="given-name"
									id="contact-first-name"
									maxlength="100"
									name="firstName"
									required
									type="text"
								>
							</div>
							<div class="contact-field">
								<label for="contact-last-name">Last name</label>
								<input
									autocomplete="family-name"
									id="contact-last-name"
									maxlength="100"
									name="lastName"
									required
									type="text"
								>
							</div>
						</div>
						<div class="contact-field">
							<label for="contact-email">Email</label>
							<input
								autocomplete="email"
								id="contact-email"
								maxlength="254"
								name="email"
								required
								type="email"
							>
						</div>
						<div class="contact-field">
							<label for="contact-phone">Phone <span>(optional)</span></label>
							<input
								autocomplete="tel"
								id="contact-phone"
								maxlength="40"
								name="phone"
								type="tel"
							>
						</div>
						<div class="contact-field">
							<label for="contact-subject">Subject</label>
							<select id="contact-subject" name="subject" required>
								<option disabled selected={!selectedSubject} value="">
									Choose a service
								</option>
								{serviceGroups.map(({ label, services, value }) => (
									<optgroup label={label}>
										{value === "advisory" && (
											<option
												selected={selectedSubject === "advisory"}
												value="advisory"
											>
												General advisory enquiry
											</option>
										)}
										{services.map(({ slug, title }) => (
											<option
												selected={slug.current === selectedSubject}
												value={slug.current}
											>
												{title}
											</option>
										))}
									</optgroup>
								))}
								<option value="general">General enquiry</option>
							</select>
						</div>
						<div class="contact-field">
							<label for="contact-message">Message</label>
							<textarea
								id="contact-message"
								maxlength="5000"
								name="message"
								required
								rows="5"
							></textarea>
						</div>
						<p class="contact-form-status" role="status">
							This preview logs your enquiry in your browser console.
						</p>
						<div class="contact-form-actions">
							<button disabled type="submit">
								Submit enquiry <span aria-hidden="true">↗</span>
							</button>
						</div>
					</form>
				</contact-enquiry>
			</section>

			<section aria-labelledby="contact-details-title" class="contact-details">
				<div class="contact-map">
					<iframe
						allowfullscreen
						height="450"
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"
						src={mapSource}
						title="Map to Neno Publishers at Blessed House, Nairobi"
						width="600"
					></iframe>
				</div>

				<div class="contact-details-panel">
					<h2 id="contact-details-title">Contact details</h2>
					<address class="contact-methods">
						<div class="contact-method">
							<h3>Email</h3>
							<a href={`mailto:${email}`}>{email}</a>
						</div>
						<div class="contact-method">
							<h3>Phone</h3>
							<div class="contact-phones">
								<a href="tel:+254731320375">0731 320 375</a>
								<a href="tel:+254748227571">0748 227 571</a>
							</div>
						</div>
						<div class="contact-method">
							<h3>Office</h3>
							<p>Blessed House, Thika Road, Nairobi</p>
							<a href={directions}
								>Get directions <span aria-hidden="true">↗</span></a
							>
						</div>
					</address>
				</div>
			</section>
		</div>
	</main>
</Layout>

<script>
	class ContactEnquiry extends HTMLElement {
		connectedCallback() {
			this.addEventListener("submit", this.logEnquiry);
			const submit = this.querySelector<HTMLButtonElement>(
				'button[type="submit"]'
			);
			if (submit) {
				submit.disabled = false;
			}
		}

		disconnectedCallback() {
			this.removeEventListener("submit", this.logEnquiry);
		}

		private readonly logEnquiry = (event: Event) => {
			if (!(event.target instanceof HTMLFormElement)) {
				return;
			}

			event.preventDefault();
			// Preview-only submission keeps the enquiry in this browser.
			console.log(
				"Contact enquiry",
				Object.fromEntries(new FormData(event.target))
			);
			const status = this.querySelector('[role="status"]');
			if (status) {
				status.textContent = "Enquiry logged in your browser console.";
			}
		};
	}

	if (!customElements.get("contact-enquiry")) {
		customElements.define("contact-enquiry", ContactEnquiry);
	}
</script>

<style>
	.contact-page {
		width: min(100% - 2 * var(--spacing-site-gutter), 78rem);
		padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem);
		margin-inline: auto;
	}

	.contact-heading {
		margin-block-end: clamp(2rem, 5vw, 4rem);
		text-align: center;
	}

	.contact-heading h1 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(3rem, 7.4vw, 6.8rem);
		font-weight: 760;
		line-height: 0.97;
		color: var(--color-ink);
		word-spacing: 0.035em;
		letter-spacing: -0.066em;
	}

	.contact-heading p {
		max-width: 45ch;
		margin: 1.15rem auto 0;
		line-height: 1.65;
		color: var(--color-ink-muted);
		text-wrap: balance;
	}

	.contact-grid,
	.contact-details,
	.contact-form-panel form,
	.contact-methods {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	.contact-grid {
		gap: clamp(1rem, 2.2vw, 1.7rem);
		align-items: start;
	}

	.contact-form-panel,
	.contact-details-panel {
		min-width: 0;
		padding: clamp(1.15rem, 3.3vw, 2.3rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
	}

	.contact-form-panel h2,
	.contact-details-panel h2 {
		margin: 0 0 1.5rem;
		font-family: var(--font-sans);
		font-size: clamp(1.55rem, 2.8vw, 2.25rem);
		font-weight: 750;
		line-height: 1.12;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	contact-enquiry {
		display: block;
	}

	.contact-name-fields,
	.contact-field {
		display: grid;
		gap: 0.5rem;
		min-width: 0;
	}

	.contact-name-fields {
		gap: 1rem;
	}

	.contact-field label {
		font-size: 0.875rem;
		font-weight: 700;
	}

	.contact-field label span {
		font-weight: 450;
		color: var(--color-ink-muted);
	}

	.contact-field :is(input, select, textarea) {
		width: 100%;
		min-width: 0;
		min-block-size: 3rem;
		padding: 0.66rem 0.8rem;
		font: inherit;
		font-size: 1rem;
		color: var(--color-ink);
		background: var(--color-surface-alt);
		border: 1px solid var(--color-border);
		border-radius: 0.55rem;
	}

	.contact-field textarea {
		resize: vertical;
	}

	.contact-page :is(input, select, textarea, a, button):focus-visible {
		outline: 2px solid var(--color-brand-primary-dark);
		outline-offset: 3px;
	}

	.contact-form-status {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--color-ink-muted);
	}

	.contact-form-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1rem;
		align-items: center;
		justify-content: space-between;
	}

	.contact-form-actions button {
		display: inline-flex;
		gap: 0.8rem;
		align-items: center;
		justify-content: center;
		min-block-size: 3rem;
		padding: 0.65rem 1.2rem;
		margin-inline-start: auto;
		font-weight: 720;
		color: var(--color-on-image);
		background: var(--color-brand-primary-dark);
		border-radius: 999px;
		transition:
			background-color 150ms ease,
			transform 160ms var(--ease-nav-settle);
	}

	.contact-form-actions button:not(:disabled) {
		cursor: pointer;
	}
	.contact-form-actions button:active {
		transform: scale(0.98);
	}
	.contact-form-actions button:disabled {
		opacity: 0.6;
	}

	.contact-map {
		overflow: hidden;
		background: var(--color-brand-primary-soft);
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
	}

	.contact-map:focus-within {
		outline: 2px solid var(--color-brand-primary-dark);
		outline-offset: 3px;
	}

	.contact-map iframe {
		display: block;
		width: 100%;
		height: clamp(16rem, 26vw, 21rem);
		border: 0;
	}

	.contact-methods {
		font-style: normal;
	}

	.contact-method {
		padding: 0.8rem 1rem;
		background: var(--color-brand-primary-soft);
		border-radius: 0.55rem;
	}

	.contact-method h3 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 730;
	}

	.contact-method p {
		margin: 0.25rem 0 0;
		line-height: 1.5;
		color: var(--color-ink-muted);
	}

	.contact-method a {
		display: inline-flex;
		gap: 0.45rem;
		align-items: center;
		min-block-size: 2.75rem;
		font-weight: 620;
		color: var(--color-brand-primary-dark);
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 150ms ease;
	}

	.contact-phones {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.1rem;
	}

	@media (min-width: 38rem) {
		.contact-name-fields {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 54rem) {
		.contact-grid {
			grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		}
	}

	@media (max-width: 38rem) {
		.contact-form-actions button {
			width: 100%;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-form-actions button:hover:not(:disabled) {
			background: var(--color-ink);
		}
		.contact-method a:hover {
			text-decoration-color: currentColor;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact-heading {
			animation: contact-enter 260ms var(--ease-nav-settle) both;
		}

		@keyframes contact-enter {
			from {
				opacity: 0;
				transform: translateY(0.35rem);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-form-actions button,
		.contact-method a {
			transition: none;
		}
		.contact-form-actions button:active {
			transform: none;
		}
	}
</style>
