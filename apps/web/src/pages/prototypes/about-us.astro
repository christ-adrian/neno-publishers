---
import Layout from "../../layouts/Layout.astro";
import Storybook from "../../prototypes/about-us/storybook.astro";
import Imprint from "../../prototypes/about-us/imprint.astro";
import AuthorsDesk from "../../prototypes/about-us/authors-desk.astro";
import "../../prototypes/about-us/picker.css";

const variants = [
	{ Component: Storybook, name: "Storybook" },
	{ Component: Imprint, name: "Imprint" },
	{ Component: AuthorsDesk, name: "Author’s Desk" },
] as const;

const requested = Astro.url.searchParams.get("v");
const initialIndex = variants.findIndex(
	(_, index) => String(index + 1) === requested
);
const activeIndex = Math.max(0, initialIndex);
const ActiveVariant = variants[activeIndex]?.Component ?? Storybook;

Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<Layout title="Neno Publishers | About Us Prototypes">
	<div id="top">
		<div id="stage">
			<ActiveVariant />
		</div>
	</div>

	{variants.map(({ Component }) => (
		<template data-about-us-variant>
			<Component />
		</template>
	))}

	<nav aria-label="Prototype variants" class="proto-picker">
		<span aria-hidden="true" class="proto-picker-highlight"></span>
		{variants.map(({ name }, index) => (
			<button
				aria-current={index === activeIndex ? "true" : undefined}
				class="proto-picker-item"
				data-active={index === activeIndex ? "" : undefined}
				type="button"
			>
				{name}
			</button>
		))}
	</nav>
</Layout>

<script>
	const stage = document.querySelector("#stage");
	const picker = document.querySelector<HTMLElement>(".proto-picker");
	const highlight = picker?.querySelector<HTMLElement>(
		".proto-picker-highlight"
	);
	const items = Array.from(
		picker?.querySelectorAll<HTMLButtonElement>(".proto-picker-item") ?? []
	);
	const templates = Array.from(
		document.querySelectorAll<HTMLTemplateElement>("[data-about-us-variant]")
	);

	if (stage && picker && highlight && items.length === templates.length) {
		let current = Math.max(
			0,
			items.findIndex((item) => item.hasAttribute("data-active"))
		);

		const moveHighlight = () => {
			const item = items[current];
			if (item) {
				highlight.style.width = `${item.offsetWidth}px`;
				highlight.style.transform = `translateX(${item.offsetLeft}px)`;
			}
		};

		const mount = (index: number) => {
			const template = templates[index];
			if (template) {
				stage.replaceChildren(template.content.cloneNode(true));
			}
		};

		const setActive = (index: number) => {
			if (index < 0 || index >= items.length || index === current) {
				return;
			}
			const template = templates[index];
			if (!template) {
				return;
			}

			current = index;
			for (const [position, item] of items.entries()) {
				item.toggleAttribute("data-active", position === index);
				if (position === index) {
					item.setAttribute("aria-current", "true");
				} else {
					item.removeAttribute("aria-current");
				}
			}

			moveHighlight();
			const url = new URL(location.href);
			url.searchParams.set("v", String(index + 1));
			if (url.hash && url.hash !== "#top") {
				let anchorId = "";
				try {
					anchorId = decodeURIComponent(url.hash.slice(1));
				} catch {
					url.hash = "";
				}
				if (anchorId && !template.content.getElementById(anchorId)) {
					url.hash = "";
				}
			}
			history.replaceState(null, "", url);
			mount(index);
		};

		for (const [index, item] of items.entries()) {
			item.addEventListener("click", () => setActive(index));
		}

		document.addEventListener("keydown", (event) => {
			if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
				return;
			}

			const target = event.target;
			if (
				target instanceof HTMLElement &&
				(target.matches("input, textarea, select") || target.isContentEditable)
			) {
				return;
			}

			let index = Number(event.key) - 1;
			if (event.key === "ArrowRight") {
				index = (current + 1) % items.length;
			} else if (event.key === "ArrowLeft") {
				index = (current - 1 + items.length) % items.length;
			} else if (event.key === "r" || event.key === "R") {
				event.preventDefault();
				mount(current);
				return;
			}

			const item = items[index];
			if (item) {
				event.preventDefault();
				setActive(index);
				item.focus({ preventScroll: true });
			}
		});

		window.addEventListener("resize", moveHighlight);
		moveHighlight();
		requestAnimationFrame(() =>
			requestAnimationFrame(() => picker.setAttribute("data-ready", ""))
		);
	}
</script>
