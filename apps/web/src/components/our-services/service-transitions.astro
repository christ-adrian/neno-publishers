<script>
	import type {
		TransitionBeforePreparationEvent,
		TransitionBeforeSwapEvent,
	} from "astro:transitions/client";

	const transitionMarker = "data-service-transition";
	const servicePath = /^\/our-services(?:\/[^/]+)?\/?$/;

	const isServicesNavigation = (from: URL, to: URL): boolean =>
		servicePath.test(from.pathname) && servicePath.test(to.pathname);

	document.addEventListener("astro:before-preparation", (event) => {
		document.documentElement.removeAttribute(transitionMarker);

		const navigation = event as TransitionBeforePreparationEvent;

		if (isServicesNavigation(navigation.from, navigation.to)) {
			document.documentElement.setAttribute(transitionMarker, "");
		}
	});

	document.addEventListener("astro:before-swap", (event) => {
		const navigation = event as TransitionBeforeSwapEvent;
		const nextRoot = navigation.newDocument.documentElement;

		nextRoot.removeAttribute(transitionMarker);

		if (isServicesNavigation(navigation.from, navigation.to)) {
			nextRoot.setAttribute(transitionMarker, "");
		}
	});
</script>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		:root[data-service-transition] .service-hero {
			view-transition-name: service-hero;
		}

		:root[data-service-transition]::view-transition-old(root),
		:root[data-service-transition]::view-transition-new(root),
		:root[data-service-transition]::view-transition-group(root),
		:root[data-service-transition]::view-transition-group(service-hero) {
			animation: none !important;
		}

		:root[data-service-transition][data-astro-transition-fallback] {
			animation-name: none !important;
		}

		/* Keep the two clipped snapshots in normal paint order. */
		:root[data-service-transition]::view-transition-old(service-hero),
		:root[data-service-transition]::view-transition-new(service-hero) {
			mix-blend-mode: normal;
		}

		:root[data-service-transition]::view-transition-old(service-hero) {
			animation: service-hero-circle-close 700ms ease-in-out both;
			opacity: 1 !important;
		}

		:root[data-service-transition]::view-transition-new(service-hero) {
			animation: service-hero-circle-open 700ms ease-in-out 700ms both;
			opacity: 1 !important;
		}

		:root[data-service-transition][data-astro-transition-fallback="old"] .service-hero {
			animation: service-hero-circle-close 700ms ease-in-out both;
		}

		:root[data-service-transition][data-astro-transition-fallback="new"] .service-hero {
			animation: service-hero-circle-open 700ms ease-in-out both;
		}
	}

	@keyframes service-hero-circle-close {
		from {
			clip-path: circle(72% at 50% 50%);
		}

		to {
			clip-path: circle(0 at 50% 50%);
		}
	}

	@keyframes service-hero-circle-open {
		from {
			clip-path: circle(0 at 50% 50%);
		}

		to {
			clip-path: circle(72% at 50% 50%);
		}
	}
</style>
