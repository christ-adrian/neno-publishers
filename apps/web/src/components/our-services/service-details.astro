---
import type { Service } from "./content";

interface Props {
	service: Service;
}

const { service } = Astro.props;
---

<section aria-labelledby="service-details" class="service-details" data-service={service.slug}>
	<h2 id="service-details">Services offered</h2>
	<ul class="service-details__list" role="list">
		{service.offerings.map(({ title, description }) => (
			<li class="service-details__item">
				<h3>{title}</h3>
				<p>{description}</p>
			</li>
		))}
	</ul>
</section>

<style>
	.service-details {
		--details-accent: var(--color-brand-primary-dark);
		margin-block-start: clamp(1.25rem, 3vw, 2.5rem);
	}

	.service-details[data-service="advisory"] {
		--details-accent: #8d352b;
	}

	.service-details[data-service="publishing"] {
		--details-accent: #124b3e;
	}

	.service-details h2 {
		margin-block-end: clamp(1rem, 3vw, 2rem);
		color: var(--details-accent);
		font-size: clamp(2rem, 4.2vw, 3.25rem);
		font-weight: 600;
		line-height: 1.1;
	}

	.service-details__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.service-details__item {
		padding: clamp(1.5rem, 3vw, 2.25rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1.5rem;
	}

	.service-details__item h3 {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: 600;
		line-height: 1.2;
	}

	.service-details__item p {
		margin-block-start: 0.85rem;
		color: var(--color-ink-muted);
		line-height: 1.7;
		text-wrap: pretty;
	}
</style>
