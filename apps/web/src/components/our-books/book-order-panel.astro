---
interface Props {
	title: string;
	priceKsh: number | null;
}

const { title, priceKsh } = Astro.props;
const formattedPrice =
	priceKsh === null
		? null
		: new Intl.NumberFormat("en-KE", { maximumFractionDigits: 2 }).format(priceKsh);
const orderMessage = `Hello, I would like to order ${title}.`;
const whatsappUrl = `https://wa.me/254748227571?text=${encodeURIComponent(orderMessage)}`;
---

<aside aria-labelledby="book-order-title" class="book-order-panel">
	<h2 id="book-order-title">Order this book</h2>
	{formattedPrice ? (
		<p class="book-order-panel__price">
			<span>Price</span>
			<strong>KSh {formattedPrice}</strong>
		</p>
	) : (
		<p class="book-order-panel__availability">
			Ask us about current pricing and availability.
		</p>
	)}
	<a
		aria-label={`Order ${title} on WhatsApp`}
		class="book-order-panel__action"
		href={whatsappUrl}
	>
		<span>Order on WhatsApp</span>
		<span aria-hidden="true" class="book-order-panel__arrow">↗</span>
	</a>
</aside>

<style>
	.book-order-panel {
		position: relative;
		padding: clamp(1.25rem, 2.8vw, 2rem);
		background: var(--color-brand-primary-soft);
		border: 1px solid color-mix(in srgb, var(--color-brand-primary-dark) 17%, var(--color-border));
	}

	.book-order-panel h2 {
		margin-block: 0 1.25rem;
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1.05;
	}

	.book-order-panel__price {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		align-items: baseline;
		padding-block: 1rem;
		margin: 0;
		border-block: 1px solid color-mix(in srgb, var(--color-brand-primary-dark) 16%, transparent);
	}

	.book-order-panel__price span {
		color: var(--color-ink-muted);
		font-size: 0.9rem;
	}

	.book-order-panel__price strong {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 550;
		line-height: 1.1;
	}

	.book-order-panel__availability {
		padding-block: 1rem;
		margin: 0;
		color: var(--color-ink-muted);
		border-block: 1px solid color-mix(in srgb, var(--color-brand-primary-dark) 16%, transparent);
		line-height: 1.6;
	}

	.book-order-panel__action {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		min-block-size: 3.25rem;
		padding: 0.8rem 1rem;
		margin-block-start: 1.25rem;
		color: var(--color-surface);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		background: var(--color-brand-primary-dark);
		transition:
			transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
			background-color 160ms ease;
	}

	.book-order-panel__action:active {
		transform: scale(0.98);
	}

	.book-order-panel__action:focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	.book-order-panel__arrow {
		font-size: 1.2rem;
		line-height: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.book-order-panel__action:hover {
			background: var(--color-image-scrim);
			transform: translateY(-1px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book-order-panel__action {
			transition: background-color 160ms ease;
		}

		.book-order-panel__action:active,
		.book-order-panel__action:hover {
			transform: none;
		}
	}
</style>
