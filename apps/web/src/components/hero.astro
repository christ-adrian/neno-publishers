---
import { Image } from "astro:assets";
import shelves from "../assets/hero-background.jpg";
---

<section aria-labelledby="hero-heading" class="hero">
	<Image
		alt=""
		class="hero-image"
		format="webp"
		priority
		sizes="96vw"
		src={shelves}
		widths={[480, 768, 1280, 1920]}
	/>
	<div class="hero-copy">
		<h1 class="hero-heading" id="hero-heading">
			<span>Your work</span>
			<span>Our priority</span>
		</h1>
		<p class="hero-description">
			Transforming your manuscript into a masterpiece with Kenya’s premier
			publishing, printing, and advisory team.
		</p>
		<div class="hero-actions">
			<a class="hero-action hero-action--primary" href="/publish-with-us">
				Submit Your Manuscript
			</a>
			<a class="hero-action hero-action--secondary" href="/contact">
				Need help? Talk to us
			</a>
		</div>
	</div>
</section>
