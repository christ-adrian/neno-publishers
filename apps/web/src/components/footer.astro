---
import { Image } from "astro:assets";
import footerPhoto from "../assets/hero-background.jpg";
import logo from "../assets/neno-logo.png";
import { navigationLinks, publishLink } from "./site-navigation";

const email = "info@nenopublishers.co.ke";
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-banner">
		<Image
			alt=""
			class="footer-photo"
			format="webp"
			sizes="100vw"
			src={footerPhoto}
			widths={[480, 768, 1280, 1920]}
		/>
		<div class="footer-wrap banner-content">
			<h2>
				Bring your book<br>
				to life
			</h2>
			<a class="publish-action" href={publishLink.href}>
				{publishLink.label}
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>

	<div class="footer-wrap">
		<div class="footer-identity">
			<a class="footer-logo" href="/">
				<Image
					alt="Neno Publishers home"
					format="webp"
					src={logo}
					width={384}
				/>
			</a>

			<address class="footer-contact">
				<div class="footer-phones">
					<a href="tel:+254731320375">0731320375</a>
					<span aria-hidden="true">//</span>
					<a href="tel:+254748227571">0748227571</a>
				</div>
				<a href={`mailto:${email}`}>{email}</a>
			</address>
		</div>

		<div class="footer-directory">
			<p>Publishing, printing and advisory services for authors in Kenya.</p>
			<nav aria-label="Footer navigation">
				<ul>
					{[...navigationLinks, publishLink].map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<p class="footer-copyright">© {year} Neno Publishers</p>
	</div>
</footer>

<style>
	.site-footer {
		--footer-gutter: clamp(1.25rem, 4.5vw, 4.5rem);

		margin-block-start: clamp(3rem, 7vw, 7rem);
		background: var(--color-surface);
	}

	.footer-wrap {
		inline-size: min(100% - 2 * var(--footer-gutter), 90rem);
		margin-inline: auto;
	}

	.footer-banner {
		position: relative;
		color: var(--color-on-image);
		background: var(--color-image-scrim);
		isolation: isolate;
	}

	.footer-photo,
	.footer-banner::after {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
	}

	.footer-photo {
		z-index: -2;
		object-fit: cover;
		object-position: center 55%;
	}

	.footer-banner::after {
		z-index: -1;
		content: "";
		background: rgb(6 27 48 / 63%);
	}

	.banner-content {
		display: grid;
		gap: 3rem;
		align-content: space-between;
		min-block-size: clamp(19rem, 39vw, 34rem);
		padding-block: clamp(2.25rem, 5vw, 5rem);
	}

	.banner-content h2 {
		font-size: clamp(2.5rem, 7.5vw, 7.25rem);
		font-weight: 500;
		line-height: 0.94;
		letter-spacing: -0.035em;
	}

	.publish-action {
		display: inline-flex;
		gap: 1.25rem;
		align-items: center;
		justify-self: end;
		min-block-size: 3rem;
		padding: 0.375rem 0.375rem 0.375rem 1.125rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-on-image);
		background: var(--color-brand-primary-dark);
		border-radius: 999px;
	}

	.publish-action span {
		display: grid;
		place-items: center;
		inline-size: 2.25rem;
		block-size: 2.25rem;
		font-size: 1.125rem;
		color: var(--color-brand-primary-dark);
		background: var(--color-surface);
		border-radius: 50%;
	}

	.footer-identity,
	.footer-directory {
		display: grid;
		gap: 1.25rem clamp(1.5rem, 4vw, 4rem);
		padding-block: clamp(1.5rem, 3vw, 2.75rem);
	}

	.footer-identity {
		align-items: center;
		border-block-end: 1px solid var(--color-border);
	}

	.footer-logo {
		justify-self: start;
	}

	.footer-logo img {
		inline-size: clamp(8.5rem, 15vw, 12rem);
	}

	.footer-contact {
		font-size: clamp(0.95rem, 2.75vw, 2.25rem);
		font-style: normal;
		font-weight: 550;
		letter-spacing: -0.025em;
		overflow-wrap: anywhere;
	}

	.footer-phones {
		display: flex;
		flex-wrap: wrap;
		column-gap: 0.35em;
		align-items: center;
	}

	.footer-phones span,
	.footer-directory p,
	.footer-copyright {
		color: var(--color-ink-muted);
	}

	.footer-contact a,
	.footer-directory a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
	}

	.footer-directory p {
		max-inline-size: 31ch;
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.footer-directory ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 0.75rem;
		font-size: 0.875rem;
		font-weight: 650;
	}

	.footer-copyright {
		padding-block: 1rem 1.75rem;
		font-size: 0.8125rem;
		border-block-start: 1px solid var(--color-border);
	}

	a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	@media (min-width: 48rem) {
		.footer-identity,
		.footer-directory {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		}

		.footer-directory p {
			padding-block-start: 0.625rem;
		}
	}

	@media (min-width: 64rem) {
		.footer-directory ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.footer-contact a:hover,
		.footer-directory a:hover {
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}

		.publish-action:hover {
			background: var(--color-image-scrim);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.publish-action {
			transition: transform 150ms var(--ease-nav-settle);
		}

		.publish-action:active {
			transform: scale(0.97);
		}
	}
</style>
