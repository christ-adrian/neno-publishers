---
import { Image } from "astro:assets";
import footerPhoto from "../assets/hero-background.jpg";
import logo from "../assets/neno-logo.png";
import { navigationLinks, publishLink } from "./site-navigation";

const email = "info@nenopublishers.co.ke";
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<section aria-labelledby="footer-heading" class="footer-wrap footer-banner">
		<Image
			alt=""
			class="footer-photo"
			format="webp"
			sizes="(min-width: 82rem) 78rem, calc(100vw - clamp(2rem, 4vw, 4rem))"
			src={footerPhoto}
			widths={[480, 768, 1280, 1536]}
		/>
		<h2 id="footer-heading">
			Bring your book<br>
			to life
		</h2>
		<p>Find the right publishing support for your manuscript.</p>
		<a class="publish-action" href={publishLink.href}>
			{publishLink.label}
			<span aria-hidden="true">→</span>
		</a>
	</section>

	<div class="footer-directory">
		<div class="footer-wrap">
			<div class="footer-columns">
				<div class="footer-identity">
					<a class="footer-logo" href="/">
						<Image
							alt="Neno Publishers home"
							format="webp"
							src={logo}
							width={384}
						/>
					</a>
					<p>
						Publishing, printing and advisory services for authors in Kenya.
					</p>
				</div>

				<nav aria-labelledby="footer-navigation-heading">
					<h2 id="footer-navigation-heading">Explore</h2>
					<ul>
						{[...navigationLinks, publishLink].map(({ href, label }) => (
							<li>
								<a href={href}>{label}</a>
							</li>
						))}
					</ul>
				</nav>

				<div>
					<h2>Get in touch</h2>
					<address>
						<a href={`mailto:${email}`}>{email}</a>
						<a href="tel:+254731320375">0731320375</a>
						<a href="tel:+254748227571">0748227571</a>
					</address>
				</div>
			</div>

			<p class="footer-copyright">© {year} Neno Publishers</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		--footer-muted: #bfc9d7;
		--footer-ink: #0b1523;

		margin-block-start: clamp(3rem, 7vw, 7rem);
	}

	.footer-wrap {
		inline-size: min(100% - 2 * var(--spacing-site-gutter), 78rem);
		margin-inline: auto;
	}

	.footer-banner {
		position: relative;
		display: grid;
		gap: 1.25rem;
		align-content: center;
		justify-items: center;
		min-block-size: clamp(20rem, 34vw, 33rem);
		padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 3.5vw, 3rem);
		margin-block-end: clamp(1rem, 2vw, 2rem);
		color: var(--color-on-image);
		text-align: center;
		background: var(--footer-ink);
		border-radius: clamp(1rem, 2.5vw, 2rem);
		isolation: isolate;
	}

	.footer-photo,
	.footer-banner::after {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		border-radius: inherit;
	}

	.footer-photo {
		z-index: -2;
		object-fit: cover;
		object-position: center 55%;
	}

	.footer-banner::after {
		z-index: -1;
		content: "";
		background: radial-gradient(
			ellipse at center,
			rgb(7 17 29 / 93%) 15%,
			rgb(7 17 29 / 79%) 55%,
			rgb(7 17 29 / 54%) 100%
		);
	}

	.footer-banner h2,
	.footer-directory h2 {
		font-family: var(--font-sans);
		font-weight: 750;
	}

	.footer-banner h2 {
		font-size: clamp(2.25rem, 6vw, 5.375rem);
		line-height: 1.02;
		letter-spacing: -0.065em;
	}

	.footer-banner p {
		max-inline-size: 36ch;
		line-height: 1.6;
		color: #e4ecf5;
		text-wrap: balance;
	}

	.publish-action {
		display: inline-flex;
		gap: 0.875rem;
		align-items: center;
		justify-content: center;
		min-block-size: 3rem;
		padding-inline: 1.25rem;
		font-size: 0.875rem;
		font-weight: 750;
		color: var(--footer-ink);
		background: #fff;
		border-radius: 999px;
	}

	.publish-action span {
		font-size: 1.125rem;
		line-height: 1;
	}

	.footer-directory {
		color: var(--color-on-image);
		background: radial-gradient(ellipse at 0 0, #122335, var(--footer-ink) 55%);
	}

	.footer-columns {
		display: grid;
		gap: clamp(1.5rem, 4vw, 4rem);
		padding-block: clamp(2rem, 5vw, 5rem);
	}

	.footer-identity p {
		max-inline-size: 28ch;
		margin-block-start: 0.875rem;
		line-height: 1.6;
	}

	.footer-logo {
		display: inline-block;
		border-radius: 0.25rem;
	}

	.footer-logo img {
		display: block;
		inline-size: clamp(8.5rem, 14vw, 11.5rem);
		block-size: auto;
		filter: brightness(0) invert(1);
	}

	.footer-directory h2 {
		margin-block-end: 0.375rem;
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.footer-directory ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1.25rem;
	}

	.footer-directory address {
		display: grid;
		justify-items: start;
		font-style: normal;
	}

	.footer-directory p,
	.footer-directory nav a,
	.footer-directory address a {
		color: var(--footer-muted);
	}

	.footer-directory nav a,
	.footer-directory address a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
		font-size: 0.875rem;
		overflow-wrap: anywhere;
		text-underline-offset: 0.2em;
	}

	.footer-copyright {
		padding-block: 1.25rem 1.75rem;
		font-size: 0.8125rem;
		border-block-start: 1px solid rgb(255 255 255 / 15%);
	}

	.site-footer a:focus-visible {
		outline: 2px solid #90d6ff;
		outline-offset: 4px;
	}

	@media (min-width: 34rem) {
		.footer-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer-identity {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 56rem) {
		.footer-columns {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr);
		}

		.footer-identity {
			grid-column: auto;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.footer-directory nav a:hover,
		.footer-directory address a:hover {
			color: var(--color-on-image);
			text-decoration: underline;
		}

		.publish-action:hover {
			background: #dfeef8;
		}
	}

	.publish-action:active {
		background: #dfeef8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.publish-action {
			transition: transform 150ms var(--ease-nav-settle);
		}

		.publish-action:active {
			transform: scale(0.97);
		}
	}
</style>
