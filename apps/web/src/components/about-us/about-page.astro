---
import { Image } from "astro:assets";
import identityCover from "../../../../../content/assets/books/my-values-my-identity.jpg";
import petalsCover from "../../../../../content/assets/books/the-little-petals-of-life.jpg";
import sudanCover from "../../../../../content/assets/books/what-matters-most-in-south-sudan.jpg";
import maryPortrait from "../../../../../content/assets/people/mary-maganga.jpg";
import samuelPortrait from "../../../../../content/assets/people/samuel-n-kanja-team.jpg";
import wilsonPortrait from "../../../../../content/assets/people/wilson-macharia-team.jpg";
import PersonCard from "../person-card.astro";
import { intro, reasons, story, storyClosing, team, values } from "./content";

const portraits = new Map([
	["Mary Maganga", maryPortrait],
	["Samuel N Kanja", samuelPortrait],
	["Wilson Macharia", wilsonPortrait],
]);
---

<main class="about" id="main-content">
	<section aria-labelledby="about-title" class="about-wrap about-hero">
		<div class="about-hero-heading">
			<h1 id="about-title">{intro.title}</h1>
			<p>{intro.lead}</p>
		</div>
		<div class="about-hero-media">
			<figure class="about-hero-covers">
				<Image
					alt="Cover of My Values; My Identity"
					format="webp"
					priority
					sizes="(min-width: 78rem) 15rem, (min-width: 42rem) 21vw, 22vw"
					src={identityCover}
					widths={[120, 240, 360, 480]}
				/>
				<Image
					alt="Cover of The Little Petals of Life"
					format="webp"
					loading="eager"
					sizes="(min-width: 78rem) 15rem, (min-width: 42rem) 21vw, 22vw"
					src={petalsCover}
					widths={[120, 240, 360, 480]}
				/>
			</figure>
			<figure class="about-hero-book">
				<Image
					alt="Cover of What Matters Most in South Sudan"
					format="webp"
					loading="eager"
					sizes="(min-width: 78rem) 15rem, (min-width: 42rem) 20vw, 30vw"
					src={sudanCover}
					widths={[120, 240, 360, 480]}
				/>
			</figure>
		</div>
	</section>

	<section aria-labelledby="story-title" class="about-wrap about-story">
		<h2 id="story-title">The story behind every book</h2>
		<div class="about-story-copy">
			{story.map((paragraph) => <p>{paragraph}</p>)}
			<ul class="about-story-closing">
				{storyClosing.map((statement) => <li>{statement}</li>)}
			</ul>
			<a class="about-action" href="/our-services"
				>Explore our services <span aria-hidden="true">↗</span></a
			>
		</div>
	</section>

	<section aria-labelledby="values-title" class="about-wrap about-values">
		<h2 id="values-title">The values behind our work</h2>
		<ul class="about-values-list">
			{values.map(({ title, description }) => (
				<li>
					<h3>{title}</h3>
					<p>{description}</p>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="reasons-title" class="about-wrap about-reasons">
		<div class="about-reasons-inner">
			<h2 id="reasons-title">Why publish with Neno?</h2>
			<ul class="about-reasons-list">
				{reasons.map(({ title, description }) => (
					<li>
						<h3>{title}</h3>
						<p>{description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section aria-labelledby="team-title" class="about-wrap about-team">
		<h2 id="team-title">Our leadership</h2>
		<ul class="about-team-list">
			{team.map(({ name, role }) => {
				const portrait = portraits.get(name);
				return (
					<PersonCard heading="h3" name={name} subtitle={role}>
						{portrait && (
							<Image
								alt=""
								format="webp"
								loading="lazy"
								sizes="(min-width: 82rem) 25.5rem, (min-width: 42rem) 32vw, 100vw"
								slot="portrait"
								src={portrait}
								widths={[240, 360, 480]}
							/>
						)}
					</PersonCard>
				);
			})}
		</ul>
	</section>
</main>

<style>
	.about {
		--about-max-width: 78rem;
		--about-radius: 0.875rem;
		--about-space: clamp(4rem, 8vw, 7.5rem);
	}

	.about-wrap {
		inline-size: min(
			var(--about-max-width),
			calc(100% - 2 * var(--spacing-site-gutter))
		);
		margin-inline: auto;
	}

	.about :where(h1, h2, h3) {
		font-family: var(--font-sans);
		font-weight: 800;
		text-wrap: balance;
	}

	.about h1 {
		max-inline-size: 12ch;
		font-size: clamp(2.75rem, 7.4vw, 7.25rem);
		line-height: 0.97;
		word-spacing: 0.035em;
		letter-spacing: -0.052em;
	}

	.about h2 {
		max-inline-size: 18ch;
		font-size: clamp(2rem, 4.65vw, 4.5rem);
		line-height: 1.02;
		word-spacing: 0.035em;
		letter-spacing: -0.05em;
	}

	.about h3 {
		font-size: clamp(1.125rem, 1.65vw, 1.5rem);
		line-height: 1.24;
		letter-spacing: -0.025em;
	}

	.about p {
		line-height: 1.65;
		color: var(--color-ink-muted);
	}

	.about-hero {
		padding-block-start: clamp(1.625rem, 5vw, 4.75rem);
	}

	.about-hero-heading {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: clamp(1.25rem, 3.5vw, 3.5rem);
		align-items: end;
		margin-block-end: clamp(1.75rem, 4vw, 3.5rem);
	}

	.about-hero-heading p {
		max-inline-size: 34ch;
		padding-block-end: 0.25rem;
		font-size: clamp(1rem, 1.45vw, 1.1875rem);
		text-wrap: pretty;
	}

	.about-hero-media {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		grid-auto-rows: clamp(19rem, 34vw, 29rem);
		gap: clamp(0.5rem, 1vw, 0.875rem);
	}

	.about-hero-covers,
	.about-hero-book {
		display: flex;
		gap: clamp(0.625rem, 2vw, 2rem);
		align-items: center;
		justify-content: center;
		min-inline-size: 0;
		overflow: hidden;
		border-radius: var(--about-radius);
	}

	.about-hero-covers {
		background: #cfe2ee;
	}

	.about-hero-book {
		background: #ece1cf;
	}

	.about-hero-media img {
		display: block;
		inline-size: auto;
		block-size: auto;
		max-block-size: 72%;
		object-fit: contain;
		border-radius: 0 0.15rem 0.15rem 0;
		box-shadow: 0.5rem 0.8rem 1.25rem rgb(6 27 48 / 22%);
	}

	.about-hero-covers img {
		max-inline-size: 38%;
	}

	.about-hero-book img {
		max-inline-size: 72%;
	}

	.about-story,
	.about-reasons-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 6vw, 6rem);
		align-items: start;
	}

	.about-story {
		padding-block: var(--about-space);
	}

	.about-story-copy {
		display: grid;
		gap: 1rem;
		max-inline-size: 56ch;
		font-size: clamp(1rem, 1.4vw, 1.1875rem);
	}

	.about-story-closing {
		padding-inline-start: 1.4em;
		list-style: disc;
	}

	.about-action {
		display: inline-flex;
		gap: 1.25rem;
		align-items: center;
		justify-self: start;
		min-block-size: 2.75rem;
		padding: 0.55rem 1.125rem;
		margin-block-start: 0.375rem;
		font-size: 0.875rem;
		font-weight: 750;
		color: var(--color-on-image);
		background: var(--color-ink);
		border-radius: 999px;
		transition:
			background-color 160ms ease-out,
			transform 160ms ease-out;
	}

	.about-action:active {
		transform: scale(0.97);
	}

	.about-action:focus-visible {
		outline: 2px solid var(--color-brand-primary-dark);
		outline-offset: 3px;
	}

	@media (hover: hover) {
		.about-action:hover {
			background: var(--color-brand-primary-dark);
		}
	}

	.about-values {
		padding-block-end: var(--about-space);
	}

	.about-values h2,
	.about-team h2 {
		margin-block-end: clamp(1.5rem, 3.75vw, 3rem);
	}

	.about-values-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		overflow: hidden;
		background: var(--color-border);
		border: 1px solid var(--color-border);
		border-radius: var(--about-radius);
	}

	.about-values-list li {
		padding: clamp(1.25rem, 3.3vw, 3rem);
		background: var(--color-surface-alt);
	}

	.about-values-list p,
	.about-reasons-list p {
		margin-block-start: 0.5rem;
	}

	.about-reasons {
		padding: clamp(1.5rem, 6vw, 5.75rem);
		color: var(--color-on-image);
		background: var(--color-image-scrim);
		border-radius: var(--about-radius);
	}

	.about-reasons-list li {
		padding-block: 1.375rem;
		border-block-start: 1px solid rgb(255 255 255 / 23%);
	}

	.about-reasons-list p {
		color: #c3d0de;
	}

	.about-team {
		padding-block: var(--about-space);
	}

	.about-team-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.875rem, 1.5vw, 1.25rem);
	}

	.about-team-list > :global(.person-card:last-child) {
		--portrait-position: center 12%;
	}

	@media (width >= 64rem) {
		.about-reasons-inner {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.5fr);
		}

		.about-reasons-list {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: clamp(1.25rem, 3vw, 3rem);
		}
	}

	@media (width < 53rem) {
		.about-values-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (width < 42rem) {
		.about-hero-heading,
		.about-story,
		.about-reasons-inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.about-hero-media {
			grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
			grid-auto-rows: clamp(9rem, 43vw, 16rem);
		}

		.about-values-list,
		.about-team-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-action {
			transition: none;
		}

		.about-action:active {
			transform: none;
		}
	}
</style>
