---
import { Image } from "astro:assets";
import logo from "../assets/neno-logo.png";
import Navigation from "./navigation.astro";
---

<header class="site-header" data-site-header>
	<div class="header-frame">
		<a class="logo-link" href="/">
			<Image
				alt="Neno Publishers home"
				format="webp"
				loading="eager"
				src={logo}
				width={256}
			/>
		</a>

		<nav aria-label="Main navigation" class="desktop-nav">
			<Navigation />
		</nav>

		<details class="mobile-nav" data-mobile-menu>
			<summary>Menu</summary>
			<nav aria-label="Main navigation" class="mobile-panel">
				<Navigation />
			</nav>
		</details>

		<a class="nav-link nav-link--publish" href="/publish-with-us">
			Publish With Us
		</a>
	</div>
</header>

<script>
	let headerListeners: AbortController | undefined;

	document.addEventListener("astro:page-load", () => {
		headerListeners?.abort();
		const header = document.querySelector("[data-site-header]");
		const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
		const trigger = menu?.querySelector("summary");

		if (header && menu && trigger) {
			const controller = new AbortController();
			headerListeners = controller;
			const { signal } = controller;
			const scrollThreshold = header.clientHeight;
			const updateHeader = () => {
				header.toggleAttribute(
					"data-floating",
					window.scrollY >= scrollThreshold
				);
			};

			updateHeader();
			window.addEventListener("scroll", updateHeader, { passive: true, signal });
			window.addEventListener("pageshow", updateHeader, { signal });

			document.addEventListener("click", (event) => {
				if (!(menu.open && event.target instanceof Element)) {
					return;
				}

				if (event.target.closest("a") || !menu.contains(event.target)) {
					menu.open = false;
				}
			}, { signal });

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && menu.open) {
					menu.open = false;
					trigger.focus();
				}
			}, { signal });

			const desktop = window.matchMedia("(min-width: 56rem)");
			desktop.addEventListener("change", () => {
				if (desktop.matches) {
					menu.open = false;
				}
			}, { signal });
		}
	});
</script>
