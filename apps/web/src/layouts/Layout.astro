---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";

interface Props {
  description?: string;
  type?: "website" | "book";
  skipTo?: string;
  title: string;
}

const { description, skipTo, title, type = "website" } = Astro.props;
const site = Astro.site ?? Astro.url;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(pathname, site);
const socialImage = new URL(`${import.meta.env.BASE_URL}images/neno-social.jpg`, site);
const status = Astro.response.status ?? 200;
const isError = status >= 400;

const diagonal = {
	old: { name: "diagonal-out", duration: "1.4s", easing: "ease", fillMode: "forwards" },
	new: { name: "diagonal-in", duration: "1.4s", easing: "ease", fillMode: "forwards" },
};
---

<!doctype html>
<html
  lang="en"
  transition:name="root"
  transition:animate={{ forwards: diagonal, backwards: diagonal }}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isError ? (
      status < 500 && <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical.href} />
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content="Neno Publishers" />
        <meta property="og:locale" content="en_KE" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={socialImage.href} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Neno Publishers logo" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <ClientRouter fallback="animate" />
  </head>
  <body class="flex min-h-screen flex-col font-sans text-ink [&>main]:grow">
    {skipTo && <a class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:rounded focus:bg-surface focus:p-3 focus:text-ink" href={`#${skipTo}`}>Skip to content</a>}
    <Header />
    <slot />
    <Footer />
    <script src="../scripts/smooth-scroll.ts"></script>
  </body>
</html>
