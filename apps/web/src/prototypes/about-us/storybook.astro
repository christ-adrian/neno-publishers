---
import { Image } from "astro:assets";
import books from "../../assets/hero-background.jpg";
import { intro, reasons, story, team, values } from "./content";

const getInitials = (name: string): string =>
  name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0] ?? "")
    .join("")
    .toUpperCase();
---

<main class="about-page">
	<section aria-labelledby="about-title" class="about-page__hero">
		<Image
			alt=""
			class="about-page__hero-image"
			format="webp"
			priority
			sizes="(min-width: 92rem) 88rem, calc(100vw - 2rem)"
			src={books}
			widths={[480, 768, 1280, 1920]}
		/>
		<div class="about-page__hero-copy">
			<h1 id="about-title">{intro.title}</h1>
			<p class="about-page__hero-lead">{intro.lead}</p>
		</div>
	</section>

	<section aria-labelledby="story-title" class="about-page__story">
		<div class="about-page__story-copy">
			<h2 id="story-title">The story behind every book</h2>
			<div class="about-page__story-text">
				{story.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<div aria-hidden="true" class="about-page__story-art">
			<figure class="about-page__story-crop about-page__story-crop--first">
				<Image
					alt=""
					class="about-page__story-image"
					format="webp"
					loading="lazy"
					sizes="(min-width: 64rem) 15rem, 30vw"
					src={books}
					widths={[240, 480, 720]}
				/>
			</figure>
			<figure class="about-page__story-crop about-page__story-crop--middle">
				<Image
					alt=""
					class="about-page__story-image"
					format="webp"
					loading="lazy"
					sizes="(min-width: 64rem) 15rem, 30vw"
					src={books}
					widths={[240, 480, 720]}
				/>
			</figure>
			<figure class="about-page__story-crop about-page__story-crop--last">
				<Image
					alt=""
					class="about-page__story-image"
					format="webp"
					loading="lazy"
					sizes="(min-width: 64rem) 15rem, 30vw"
					src={books}
					widths={[240, 480, 720]}
				/>
			</figure>
		</div>
	</section>

	<section aria-labelledby="values-title" class="about-page__identity">
		<div class="about-page__identity-inner">
			<h2 id="values-title">The values behind our work</h2>

			<div class="about-page__values-panel">
				<Image
					alt=""
					class="about-page__values-image"
					format="webp"
					loading="lazy"
					sizes="(min-width: 78rem) 33rem, (min-width: 48rem) 42vw, 100vw"
					src={books}
					widths={[320, 480, 640, 960, 1280]}
				/>
				<ul class="about-page__values-list">
					{values.map(({ title, description }) => (
						<li class="about-page__value">
							<h3>{title}</h3>
							<p>{description}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section aria-labelledby="reasons-title" class="about-page__reasons">
		<div class="about-page__section-heading">
			<h2 id="reasons-title">Why publish with Neno?</h2>
		</div>
		<ul class="about-page__reasons-list">
			{reasons.map(({ title, description }) => (
				<li class="about-page__reason">
					<h3>{title}</h3>
					<p>{description}</p>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="team-title" class="about-page__team">
		<div class="about-page__section-heading">
			<h2 id="team-title">Our leadership</h2>
		</div>
		<ul class="about-page__team-list">
			{team.map((person) => (
				<li class="about-page__team-card">
					<div class="about-page__team-portrait">
						{person.image ? (
							<img
								alt={`Portrait of ${person.name}`}
								class="about-page__team-image"
								decoding="async"
								loading="lazy"
								src={person.image}
							/>
						) : (
							<span aria-hidden="true" class="about-page__team-initials">
								{getInitials(person.name)}
							</span>
						)}
					</div>
					<div class="about-page__team-copy">
						<h3>{person.name}</h3>
						<p>{person.role}</p>
					</div>
				</li>
			))}
		</ul>
	</section>

</main>

<style>
	.about-page {
		--about-content-width: 78rem;
		--about-section-space: clamp(4rem, 8vw, 7.5rem);
		color: var(--color-ink);
	}

	.about-page :where(h1, h2, h3, p, figure) {
		margin: 0;
	}

	.about-page h1,
	.about-page h2,
	.about-page h3 {
		font-family: var(--font-serif);
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	.about-page__hero {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: min(90rem, calc(100% - 2 * var(--spacing-site-gutter)));
		min-block-size: clamp(28rem, 57svh, 43rem);
		padding: clamp(2rem, 6vw, 5rem);
		margin: 0 auto;
		overflow: hidden;
		color: var(--color-on-image);
		text-align: center;
		background: var(--color-image-scrim);
		border-radius: var(--radius-hero);
		isolation: isolate;
	}

	.about-page__hero::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		content: "";
		background: linear-gradient(
			120deg,
			color-mix(in srgb, var(--color-image-scrim) 92%, transparent),
			color-mix(in srgb, var(--color-image-scrim) 55%, transparent) 58%,
			color-mix(in srgb, var(--color-image-scrim) 72%, transparent)
		);
	}

	.about-page__hero-image {
		position: absolute;
		inset: 0;
		z-index: -2;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		object-position: center 43%;
	}

	.about-page__hero-copy {
		inline-size: min(100%, 54rem);
	}

	.about-page__hero h1 {
		font-size: clamp(2.8rem, 8vw, 6.6rem);
		line-height: 0.98;
		text-wrap: balance;
	}

	.about-page__hero-lead {
		max-inline-size: 48ch;
		margin: 1.5rem auto 0 !important;
		font-size: clamp(1.05rem, 1.8vw, 1.3rem);
		line-height: 1.65;
		text-wrap: pretty;
	}

	.about-page__story,
	.about-page__reasons,
	.about-page__team {
		inline-size: min(var(--about-content-width), calc(100% - 2 * var(--spacing-site-gutter)));
		margin-inline: auto;
	}

	.about-page__story {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
		gap: clamp(2.5rem, 7vw, 6.5rem);
		align-items: center;
		padding: clamp(2rem, 6vw, 5.5rem);
		margin-block: var(--about-section-space);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: clamp(1.5rem, 3vw, 2.5rem);
		box-shadow: 0 24px 72px -56px rgb(15 23 42 / 35%);
	}

	.about-page__story h2,
	.about-page__identity h2,
	.about-page__section-heading h2 {
		font-size: clamp(2rem, 4.5vw, 3.6rem);
		line-height: 1.06;
		text-wrap: balance;
	}

	.about-page__story-text {
		display: grid;
		gap: 1rem;
		max-inline-size: 62ch;
		margin-block-start: 1.5rem;
		font-size: clamp(1rem, 1.3vw, 1.125rem);
		line-height: 1.8;
		color: var(--color-ink-muted);
		text-wrap: pretty;
	}

	.about-page__story-art {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.5rem, 1.5vw, 1.25rem);
		align-items: center;
		min-inline-size: 0;
	}

	.about-page__story-crop {
		block-size: clamp(12rem, 24vw, 21rem);
		overflow: hidden;
		background: var(--color-brand-primary-soft);
		border-radius: 1.5rem 1.5rem 0.5rem 0.5rem;
	}

	.about-page__story-crop--first {
		margin-block-start: 2.25rem;
	}

	.about-page__story-crop--middle {
		block-size: clamp(15rem, 30vw, 25rem);
		border-radius: 2.25rem 2.25rem 0.5rem 0.5rem;
	}

	.about-page__story-crop--last {
		margin-block-end: 2.25rem;
		border-radius: 1.5rem 1.5rem 0.5rem 0.5rem;
	}

	.about-page__story-image {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.about-page__story-crop--first .about-page__story-image {
		object-position: center 8%;
	}

	.about-page__story-crop--middle .about-page__story-image {
		object-position: center 48%;
	}

	.about-page__story-crop--last .about-page__story-image {
		object-position: center 90%;
	}

	.about-page__identity {
		padding: var(--about-section-space) var(--spacing-site-gutter) calc(var(--about-section-space) + 1rem);
		text-align: center;
		background: var(--color-brand-primary-soft);
	}

	.about-page__identity-inner {
		inline-size: min(var(--about-content-width), 100%);
		margin-inline: auto;
	}

	.about-page__values-panel {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		margin-block-start: clamp(2rem, 4vw, 3.5rem);
		overflow: hidden;
		color: var(--color-on-image);
		text-align: start;
		background: var(--color-brand-primary-dark);
		border-radius: clamp(1.5rem, 3vw, 2.5rem);
		box-shadow: 0 28px 60px -45px rgb(6 27 48 / 65%);
	}

	.about-page__values-image {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		object-position: center 48%;
	}

	.about-page__values-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 2.5vw, 2rem);
		align-content: center;
		padding: clamp(2rem, 4vw, 3.25rem);
		margin: 0;
		list-style: none;
	}

	.about-page__value {
		min-inline-size: 0;
	}

	.about-page__value h3,
	.about-page__reason h3,
	.about-page__team-card h3 {
		font-size: clamp(1.35rem, 2vw, 1.75rem);
		line-height: 1.15;
	}

	.about-page__value p {
		margin-block-start: 0.65rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: color-mix(in srgb, var(--color-on-image) 82%, transparent);
		text-wrap: pretty;
	}

	.about-page__section-heading {
		max-inline-size: 46rem;
		margin: 0 auto clamp(2.25rem, 4vw, 3.5rem);
		text-align: center;
	}

	.about-page__reasons {
		padding-block: var(--about-section-space);
	}

	.about-page__reasons-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.about-page__reason {
		min-block-size: 15rem;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1.5rem;
		transition:
			transform 180ms var(--ease-nav-settle),
			box-shadow 180ms var(--ease-nav-settle),
			border-color 180ms ease;
	}


	.about-page__reason p {
		margin-block-start: 0.85rem;
		line-height: 1.7;
		color: var(--color-ink-muted);
		text-wrap: pretty;
	}

	.about-page__team {
		padding-block: 0 var(--about-section-space);
	}

	.about-page__team-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.about-page__team-card {
		min-inline-size: 0;
		padding: 1rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1.5rem;
	}

	.about-page__team-portrait {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		overflow: hidden;
		color: var(--color-brand-primary-dark);
		background: var(--color-brand-primary-soft);
		border-radius: 1rem;
	}

	.about-page__team-image {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.about-page__team-initials {
		font-family: var(--font-serif);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 600;
		letter-spacing: -0.05em;
	}

	.about-page__team-copy {
		padding: 1.25rem 0.5rem 0.4rem;
	}

	.about-page__team-card h3 {
		font-size: clamp(1.25rem, 1.8vw, 1.55rem);
	}

	.about-page__team-card p {
		margin-block-start: 0.45rem;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
	}

	@media (hover: hover) {
		.about-page__reason:hover {
			border-color: color-mix(in srgb, var(--color-brand-primary) 45%, var(--color-border));
			box-shadow: 0 20px 48px -40px rgb(15 23 42 / 35%);
			transform: translateY(-3px);
		}
	}

	@media (max-width: 64rem) {
		.about-page__story {
			grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.85fr);
			gap: 2.5rem;
		}

	}

	@media (max-width: 48rem) {
		.about-page__hero {
			min-block-size: min(34rem, calc(100svh - 6rem));
			padding: 2rem 1.25rem;
			border-radius: 1.5rem;
		}

		.about-page__hero-image {
			object-position: center 48%;
		}

		.about-page__story {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: clamp(1.5rem, 6vw, 2.5rem);
		}

		.about-page__story-crop,
		.about-page__story-crop--middle {
			block-size: auto;
			aspect-ratio: 0.72;
		}

		.about-page__story-crop--first,
		.about-page__story-crop--last {
			margin: 0;
		}

		.about-page__story-crop--middle {
			border-radius: 1.5rem 1.5rem 0.5rem 0.5rem;
		}

		.about-page__values-panel {
			grid-template-columns: minmax(0, 1fr);
		}

		.about-page__values-image {
			block-size: auto;
			aspect-ratio: 1.7;
		}

		.about-page__values-list {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: clamp(1.5rem, 6vw, 2.25rem);
		}
	}

	@media (max-width: 36rem) {
		.about-page__hero {
			min-block-size: 29rem;
		}

		.about-page__hero h1 {
			font-size: clamp(2.6rem, 13vw, 4rem);
		}

		.about-page__identity {
			padding-inline: 1rem;
		}

		.about-page__team-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.about-page__team-card {
			padding: 0.65rem;
			border-radius: 1.1rem;
		}

		.about-page__team-portrait {
			border-radius: 0.75rem;
		}

		.about-page__team-copy {
			padding: 0.9rem 0.25rem 0.3rem;
		}

		.about-page__team-card h3 {
			font-size: 1.2rem;
		}

		.about-page__team-card p {
			font-size: 0.8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-page__reason {
			transition: none;
		}

		.about-page__reason:hover {
			transform: none;
		}
	}
</style>
