---
import { Image } from "astro:assets";
import shelves from "../../assets/hero-background.jpg";
import { intro, mission, reasons, story, team, values, vision } from "./content";

const initials = (name: string) =>
	name
		.trim()
		.split(/\s+/)
		.slice(0, 2)
		.map((part) => part.slice(0, 1))
		.join("");
---

<main class="imprint-page">
	<div class="imprint-topline">
		<span class="imprint-topline-label">About Neno</span>
		<span class="imprint-location">{intro.location}</span>
	</div>

	<section aria-labelledby="imprint-title" class="imprint-intro">
		<div class="imprint-intro-copy">
			<p class="imprint-eyebrow">
				<span class="imprint-eyebrow-mark" aria-hidden="true"></span>
				Publishing, with purpose
			</p>
			<h1 id="imprint-title">{intro.title}</h1>
			<p class="imprint-lead">{intro.lead}</p>
			<a class="imprint-text-link" href="#our-story">
				Read our story
				<span aria-hidden="true">↓</span>
			</a>
		</div>

		<figure class="imprint-hero-figure">
			<div class="imprint-image-frame">
				<Image
					alt="Rows of colorful books and folders arranged on shelves."
					class="imprint-hero-image"
					format="webp"
					priority
					sizes="(max-width: 52rem) 92vw, 46vw"
					src={shelves}
					widths={[480, 768, 1080, 1440]}
				/>
			</div>
			<figcaption class="imprint-image-caption">
				<span>A place for ideas to take shape.</span>
			</figcaption>
		</figure>

		<p class="imprint-intro-index" aria-hidden="true">
			<span aria-hidden="true">—</span>
			<span>Who we are</span>
		</p>
	</section>

	<section
		aria-labelledby="story-title"
		class="imprint-chapter imprint-story"
		id="our-story"
	>
		<div class="imprint-chapter-heading">
			<p class="imprint-chapter-marker">
				<span aria-hidden="true">—</span>
				<span>Our story</span>
			</p>
			<h2 id="story-title">A publishing journey, told one page at a time.</h2>
		</div>

		<div class="imprint-story-copy">
			{story.map((paragraph) => (
				<p class="imprint-story-paragraph">
					<span aria-hidden="true">—</span>
					<span>{paragraph}</span>
				</p>
			))}
		</div>
	</section>

	<section
		aria-labelledby="purpose-title"
		class="imprint-chapter imprint-purpose"
		id="purpose"
	>
		<div class="imprint-chapter-heading">
			<p class="imprint-chapter-marker">
				<span aria-hidden="true">—</span>
				<span>Our purpose</span>
			</p>
			<h2 id="purpose-title">The work that guides us.</h2>
		</div>

		<div class="imprint-purpose-grid">
			<article aria-labelledby="mission-title" class="imprint-purpose-card imprint-mission">
				<h3 id="mission-title">Mission</h3>
				<p>{mission}</p>
			</article>
			<article aria-labelledby="vision-title" class="imprint-purpose-card imprint-vision">
				<p class="imprint-card-index">Looking ahead</p>
				<h3 id="vision-title">What we aim for</h3>
				<p>{vision}</p>
			</article>
		</div>
	</section>

	<section
		aria-labelledby="principles-title"
		class="imprint-chapter imprint-principles-section"
		id="reasons-and-values"
	>
		<div class="imprint-chapter-heading">
			<p class="imprint-chapter-marker">
				<span aria-hidden="true">—</span>
				<span>What matters</span>
			</p>
			<h2 id="principles-title">Good work begins with good principles.</h2>
		</div>

		<div class="imprint-principles-grid">
			<section aria-labelledby="reasons-title" class="imprint-principle-group">
				<div class="imprint-group-heading">
					<p class="imprint-group-index">For our clients</p>
					<h3 id="reasons-title">Why Neno</h3>
				</div>
				<ol class="imprint-point-grid">
					{reasons.map((reason) => (
						<li class="imprint-point">
							<span aria-hidden="true">—</span>
							<div>
								<h4>{reason.title}</h4>
								<p>{reason.description}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="values-title" class="imprint-principle-group imprint-values">
				<div class="imprint-group-heading">
					<p class="imprint-group-index">In every project</p>
					<h3 id="values-title">Our values</h3>
				</div>
				<ul class="imprint-point-grid">
					{values.map((value) => (
						<li class="imprint-point">
							<span aria-hidden="true">—</span>
							<div>
								<h4>{value.title}</h4>
								<p>{value.description}</p>
							</div>
						</li>
					))}
				</ul>
			</section>
		</div>
	</section>

	<section
		aria-labelledby="team-title"
		class="imprint-chapter imprint-team"
		id="our-team"
	>
		<div class="imprint-chapter-heading">
			<p class="imprint-chapter-marker">
				<span aria-hidden="true">—</span>
				<span>Meet the team</span>
			</p>
			<h2 id="team-title">People behind the publishing.</h2>
		</div>

		<div class="imprint-team-grid">
			{team.map((member) => (
				<article class="imprint-team-card">
					<div class="imprint-team-portrait">
						{member.image ? (
							<img
								alt={`Portrait of ${member.name}`}
								decoding="async"
								loading="lazy"
								src={member.image}
							/>
						) : (
							<span aria-hidden="true" class="imprint-team-initials">
								{initials(member.name)}
							</span>
						)}
					</div>
					<div class="imprint-team-meta">
						<h3>{member.name}</h3>
						<p>{member.role}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section aria-labelledby="next-title" class="imprint-next-step" id="next-steps">
		<div class="imprint-next-copy">
			<p class="imprint-chapter-marker imprint-next-marker">
				<span aria-hidden="true">—</span>
				<span>Turn the page</span>
			</p>
			<h2 id="next-title">Your next chapter starts here.</h2>
		</div>
		<nav aria-label="Explore Neno Publishers" class="imprint-next-links">
			<a href="/our-services">
				<span>Explore our services</span>
				<span aria-hidden="true">→</span>
			</a>
			<a href="/publish-with-us">
				<span>Publish with us</span>
				<span aria-hidden="true">→</span>
			</a>
		</nav>
	</section>
</main>

<style>
	.imprint-page {
		--imprint-accent: var(--color-brand-primary-dark);
		--imprint-soft: var(--color-brand-primary-soft);
		--imprint-ink: var(--color-ink);
		--imprint-muted: var(--color-ink-muted);

		width: min(100%, 96rem);
		padding-inline: clamp(1.25rem, 5.5vw, 6.5rem);
		padding-block: 0 7rem;
		margin-inline: auto;
		color: var(--imprint-ink);
	}

	.imprint-topline {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.25rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--color-border);
	}

	.imprint-topline-label {
		color: var(--imprint-accent);
	}

	.imprint-location {
		color: var(--imprint-muted);
		font-weight: 550;
		letter-spacing: 0.04em;
		text-align: end;
		text-transform: none;
	}

	.imprint-intro {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 7vw, 7.5rem);
		align-items: center;
		padding-block: clamp(4rem, 8vw, 8rem) clamp(5rem, 9vw, 9rem);
	}

	.imprint-intro-copy {
		position: relative;
		z-index: 1;
		padding-block: 1.5rem;
	}

	.imprint-eyebrow,
	.imprint-chapter-marker,
	.imprint-group-index,
	.imprint-card-index {
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.imprint-eyebrow {
		display: flex;
		gap: 0.65rem;
		align-items: center;
		margin: 0 0 1.5rem;
		color: var(--imprint-accent);
	}

	.imprint-eyebrow-mark {
		width: 0.6rem;
		aspect-ratio: 1;
		background: var(--color-brand-secondary);
		border-radius: 50%;
	}

	.imprint-intro h1 {
		max-width: 8ch;
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3.75rem, 8.6vw, 8.5rem);
		font-weight: 500;
		letter-spacing: -0.075em;
		line-height: 0.86;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.imprint-lead {
		max-width: 37ch;
		margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
		color: var(--imprint-muted);
		font-size: clamp(1rem, 1.55vw, 1.3rem);
		line-height: 1.75;
	}

	.imprint-text-link {
		display: inline-flex;
		gap: 0.8rem;
		align-items: center;
		padding-block: 0.35rem;
		margin-block-start: 2rem;
		color: var(--imprint-accent);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.imprint-text-link span {
		font-size: 1.1rem;
		line-height: 1;
	}

	.imprint-hero-figure {
		position: relative;
		z-index: 0;
		min-width: 0;
		padding: 0.85rem;
		margin: 0 0 0 1rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: 0 2rem 5rem -3rem rgb(15 23 42 / 28%);
		isolation: isolate;
	}

	.imprint-hero-figure::before {
		position: absolute;
		inset: 1.5rem 1.5rem -1.3rem -1.3rem;
		z-index: -1;
		content: "";
		background: var(--imprint-soft);
		border: 1px solid color-mix(in srgb, var(--imprint-accent) 18%, transparent);
	}

	.imprint-hero-figure::after {
		position: absolute;
		inset-block-start: -0.7rem;
		inset-inline-end: -0.7rem;
		width: 1.4rem;
		aspect-ratio: 1;
		content: "";
		background: var(--color-brand-secondary);
		border-radius: 50%;
	}

	.imprint-image-frame {
		aspect-ratio: 0.94;
		overflow: hidden;
		background: var(--imprint-soft);
	}

	.imprint-hero-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 43%;
	}

	.imprint-image-caption {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 0.2rem 0.1rem;
		color: var(--imprint-muted);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.imprint-intro-index {
		position: absolute;
		inset-inline-start: 0;
		inset-block-end: 1.75rem;
		display: flex;
		gap: 0.8rem;
		align-items: center;
		margin: 0;
		color: var(--imprint-muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.imprint-intro-index span:first-child {
		color: var(--imprint-accent);
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: 0;
	}

	.imprint-chapter {
		padding-block: clamp(3.75rem, 7vw, 7rem);
		border-top: 1px solid var(--color-border);
		scroll-margin-block-start: 6.5rem;
	}

	.imprint-chapter-heading {
		display: grid;
		grid-template-columns: minmax(10rem, 0.58fr) minmax(0, 1.42fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: start;
		margin-block-end: clamp(2rem, 4.5vw, 4.25rem);
	}

	.imprint-chapter-marker {
		display: flex;
		gap: 0.8rem;
		align-items: baseline;
		margin: 0;
		color: var(--imprint-muted);
	}

	.imprint-chapter-marker span:first-child {
		color: var(--imprint-accent);
		font-family: var(--font-serif);
		font-size: 1.8rem;
		font-weight: 500;
		letter-spacing: -0.04em;
	}

	.imprint-chapter-heading h2 {
		max-width: 15ch;
		margin: -0.3rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(2.6rem, 5.4vw, 5.25rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.imprint-story-copy {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem clamp(1.5rem, 4vw, 4rem);
		margin-inline-start: min(24%, 18rem);
	}

	.imprint-story-paragraph {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0.9rem;
		margin: 0;
		color: var(--imprint-muted);
		font-size: 0.98rem;
		line-height: 1.85;
	}

	.imprint-story-paragraph > span:first-child {
		padding-block-start: 0.25rem;
		color: var(--imprint-accent);
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.08em;
	}

	.imprint-story-paragraph:first-child {
		grid-column: 1 / -1;
		max-width: 52rem;
		color: var(--imprint-ink);
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.2vw, 2rem);
		line-height: 1.5;
	}

	.imprint-story-paragraph:first-child > span:first-child {
		padding-block-start: 0.5rem;
		font-family: var(--font-sans);
		font-size: 0.7rem;
	}

	.imprint-purpose-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: 0;
		align-items: start;
		margin-inline-start: min(24%, 18rem);
		isolation: isolate;
	}

	.imprint-purpose-card {
		min-width: 0;
		padding: clamp(1.5rem, 3.3vw, 3.25rem);
	}

	.imprint-mission {
		position: relative;
		z-index: 1;
		min-height: 19rem;
		color: var(--color-surface);
		background: var(--color-brand-primary-dark);
	}

	.imprint-vision {
		min-height: 21rem;
		margin-block-start: 3.5rem;
		margin-inline-start: -1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: 0 1.5rem 4rem -3rem rgb(15 23 42 / 24%);
	}

	.imprint-card-index {
		display: flex;
		gap: 0.7rem;
		align-items: center;
		margin: 0 0 2rem;
		opacity: 0.85;
	}

	.imprint-card-index span {
		font-weight: 600;
		letter-spacing: 0.1em;
		opacity: 0.78;
	}

	.imprint-purpose-card h3 {
		margin: 0 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 4.3vw, 4.2rem);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}

	.imprint-purpose-card > p:last-child {
		max-width: 33ch;
		margin: 0;
		font-size: 0.96rem;
		line-height: 1.8;
	}

	.imprint-vision > p:last-child {
		color: var(--imprint-muted);
	}

	.imprint-principles-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
		gap: clamp(2rem, 6vw, 6rem);
	}

	.imprint-principle-group {
		min-width: 0;
	}

	.imprint-values {
		padding: clamp(1.5rem, 3.3vw, 3rem);
		background: var(--imprint-soft);
	}

	.imprint-group-heading {
		padding-block-end: 1.3rem;
		border-bottom: 1px solid color-mix(in srgb, var(--imprint-accent) 22%, transparent);
	}

	.imprint-group-index {
		margin: 0 0 0.75rem;
		color: var(--imprint-accent);
		font-size: 0.66rem;
	}

	.imprint-group-heading h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 3.5vw, 3.3rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.imprint-point-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 1.4rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.imprint-point {
		display: grid;
		grid-template-columns: 1.55rem minmax(0, 1fr);
		gap: 0.7rem;
		padding-block: 1.2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--imprint-accent) 18%, transparent);
	}

	.imprint-point > span {
		padding-block-start: 0.25rem;
		color: var(--imprint-accent);
		font-size: 0.65rem;
		font-weight: 750;
		letter-spacing: 0.07em;
	}

	.imprint-point h4 {
		margin: 0 0 0.45rem;
		font-family: var(--font-sans);
		font-size: 0.98rem;
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.imprint-point p {
		margin: 0;
		color: var(--imprint-muted);
		font-size: 0.83rem;
		line-height: 1.7;
	}

	.imprint-team-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.25rem, 3.2vw, 3rem);
		margin-inline-start: min(24%, 18rem);
	}

	.imprint-team-card {
		min-width: 0;
	}

	.imprint-team-portrait {
		display: grid;
		width: min(100%, 18rem);
		aspect-ratio: 1;
		place-items: center;
		overflow: hidden;
		background: linear-gradient(145deg, var(--imprint-soft), #fff);
		border: 1px solid var(--color-border);
		border-radius: 50%;
	}

	.imprint-team-portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.imprint-team-initials {
		color: var(--imprint-accent);
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 5vw, 5rem);
		letter-spacing: -0.08em;
	}

	.imprint-team-meta {
		padding: 1.1rem 0.25rem 0;
	}


	.imprint-team-meta h3 {
		margin: 0 0 0.35rem;
		font-family: var(--font-serif);
		font-size: clamp(1.45rem, 2.35vw, 2.2rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.1;
	}

	.imprint-team-meta > p:last-child {
		max-width: 27ch;
		margin: 0;
		color: var(--imprint-muted);
		font-size: 0.84rem;
		line-height: 1.65;
	}

	.imprint-next-step {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
		gap: 2.5rem;
		align-items: end;
		padding: clamp(2rem, 5vw, 5rem);
		margin-block-start: clamp(2rem, 5vw, 5rem);
		color: var(--color-surface);
		background: var(--color-image-scrim);
		isolation: isolate;
		overflow: hidden;
	}

	.imprint-next-step::after {
		position: absolute;
		inset-block-start: -9rem;
		inset-inline-end: 18%;
		z-index: -1;
		width: 21rem;
		aspect-ratio: 1;
		content: "";
		border: 1px solid rgb(255 255 255 / 12%);
		border-radius: 50%;
		box-shadow: 0 0 0 2.5rem rgb(255 255 255 / 4%), 0 0 0 5rem rgb(255 255 255 / 3%);
	}

	.imprint-next-copy {
		max-width: 42rem;
	}

	.imprint-next-marker {
		margin-block-end: 1.5rem;
		color: rgb(255 255 255 / 70%);
	}

	.imprint-next-marker span:first-child {
		color: #9ddcf4;
	}

	.imprint-next-copy h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 5.5vw, 5.5rem);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 0.94;
		text-wrap: balance;
	}

	.imprint-next-links {
		display: grid;
		gap: 0.75rem;
	}

	.imprint-next-links a {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		min-height: 3.5rem;
		padding: 0.8rem 1rem;
		color: var(--color-surface);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid rgb(255 255 255 / 38%);
		transition:
			color 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease;
	}

