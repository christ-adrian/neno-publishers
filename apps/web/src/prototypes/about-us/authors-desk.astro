---
import { Image } from "astro:assets";
import heroBackground from "../../assets/hero-background.jpg";
import { intro, mission, reasons, story, team, values, vision } from "./content";

const sectionLinks = [
  { href: "#authors-desk-story", label: "Our story" },
  { href: "#authors-desk-purpose", label: "Our purpose" },
  { href: "#authors-desk-values", label: "Our values" },
  { href: "#authors-desk-reasons", label: "Why Neno" },
  { href: "#authors-desk-team", label: "Our people" },
  { href: "#authors-desk-next", label: "Next steps" },
];

const initialsFor = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("");
---

<main class="authors-desk" id="authors-desk-top">
  <section class="ad-hero" aria-labelledby="authors-desk-title">
    <Image
      src={heroBackground}
      alt=""
      class="ad-hero__image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="ad-hero__veil" aria-hidden="true"></div>
    <div class="ad-hero__copy">
      <p class="ad-eyebrow ad-hero__eyebrow">A publisher’s desk</p>
      <h1 id="authors-desk-title">{intro.title}</h1>
      <p class="ad-hero__lead">{intro.lead}</p>
      <p class="ad-hero__place">
        <span class="ad-hero__place-mark" aria-hidden="true"></span>
        {intro.location}
      </p>
    </div>
    <span class="ad-hero__folio" aria-hidden="true">NENO / EST. IN STORIES</span>
  </section>

  <div class="ad-reading-layout">
    <nav class="ad-index" aria-label="About Neno sections">
      <p class="ad-index__label">On this page</p>
      <ol>
        {sectionLinks.map((section) => (
          <li>
            <a href={section.href}>
              <span aria-hidden="true">–</span>
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="ad-article">
      <section class="ad-section ad-story" aria-labelledby="authors-desk-story">
        <div class="ad-section__heading">
          <p class="ad-eyebrow">The beginning</p>
          <h2 id="authors-desk-story" tabindex="-1">Our story</h2>
        </div>
        <div class="ad-story__copy">
          {story.map((paragraph, index) => (
            <p class:list={["ad-story__paragraph", index === 0 && "ad-story__paragraph--lead"]}>
              {paragraph}
            </p>
          ))}
        </div>
      </section>

      <section class="ad-section" aria-labelledby="authors-desk-purpose">
        <div class="ad-section__heading">
          <p class="ad-eyebrow">What keeps us moving</p>
          <h2 id="authors-desk-purpose" tabindex="-1">Purpose with a point of view</h2>
        </div>
        <div class="ad-purpose">
          <div class="ad-purpose__item">
            <p class="ad-purpose__label">Our mission</p>
            <p class="ad-purpose__copy">{mission}</p>
          </div>
          <div class="ad-purpose__item">
            <p class="ad-purpose__label">What we aim for</p>
            <p class="ad-purpose__copy">{vision}</p>
          </div>
        </div>
      </section>

      <section class="ad-section" aria-labelledby="authors-desk-values">
        <div class="ad-section__heading">
          <p class="ad-eyebrow">The principles on our shelves</p>
          <h2 id="authors-desk-values" tabindex="-1">What we believe</h2>
        </div>
        <ol class="ad-list ad-values">
          {values.map((value) => (
            <li class="ad-list__item">
              <span class="ad-list__number" aria-hidden="true">–</span>
              <div>
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="ad-section" aria-labelledby="authors-desk-reasons">
        <div class="ad-section__heading">
          <p class="ad-eyebrow">Why Neno</p>
          <h2 id="authors-desk-reasons" tabindex="-1">A thoughtful home for good ideas</h2>
        </div>
        <ol class="ad-list ad-reasons">
          {reasons.map((reason) => (
            <li class="ad-list__item">
              <span class="ad-list__number" aria-hidden="true">–</span>
              <div>
                <h3>{reason.title}</h3>
                <p>{reason.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="ad-section" aria-labelledby="authors-desk-team">
        <div class="ad-section__heading">
          <p class="ad-eyebrow">The people behind the pages</p>
          <h2 id="authors-desk-team" tabindex="-1">Meet our leadership</h2>
        </div>
        <ul class="ad-team">
          {team.map((member) => (
            <li class="ad-team__person">
              <div class="ad-team__portrait">
                {member.image ? (
                  <Image
                    src={member.image}
                    alt={`Portrait of ${member.name}`}
                    width={144}
                    height={144}
                  />
                ) : (
                  <span aria-hidden="true">{initialsFor(member.name)}</span>
                )}
              </div>
              <div class="ad-team__details">
                <h3>{member.name}</h3>
                <p>{member.role}</p>
              </div>
              <span class="ad-team__arrow" aria-hidden="true">↗</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="ad-next" id="authors-desk-next" aria-labelledby="authors-desk-next-title">
        <div class="ad-next__copy">
          <p class="ad-eyebrow">Keep the story going</p>
          <h2 id="authors-desk-next-title" tabindex="-1">There’s room for your next chapter.</h2>
          <p>Meet the voices we publish, explore our work, or tell us what you’re making.</p>
        </div>
        <div class="ad-next__links" aria-label="Explore Neno Publishers">
          <a href="/our-authors/">Meet our authors <span aria-hidden="true">↗</span></a>
          <a href="/our-books/">Explore our books <span aria-hidden="true">↗</span></a>
          <a href="/publish-with-us/">Publish with us <span aria-hidden="true">↗</span></a>
          <a href="/contact-us/">Talk to our team <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </article>
  </div>
</main>

<style>
  .authors-desk {
    --ad-paper: #fbfaf6;
    --ad-ink: #112b40;
    --ad-muted: #536675;
    --ad-rule: color-mix(in srgb, var(--ad-ink) 16%, transparent);
    --ad-blue: #159ad6;
    --ad-coral: #e55551;
    color: var(--ad-ink);
    padding-block: 0 5rem;
  }

  .ad-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-block-size: clamp(30rem, 53vw, 42rem);
    inline-size: calc(100% - 2 * var(--spacing-site-gutter));
    max-inline-size: 92rem;
    padding: clamp(2rem, 6vw, 5.75rem);
    margin: 1rem auto 0;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #102a40;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: var(--radius-hero);
  }

  .ad-hero__image,
  .ad-hero__veil {
    position: absolute;
    z-index: -1;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .ad-hero__image {
    object-fit: cover;
    object-position: center 44%;
    opacity: 0.72;
  }

  .ad-hero__veil {
    background:
      linear-gradient(90deg, rgb(8 31 48 / 96%) 0%, rgb(8 31 48 / 84%) 39%, rgb(8 31 48 / 24%) 100%),
      linear-gradient(0deg, rgb(8 31 48 / 60%), transparent 55%);
  }

  .ad-hero__copy {
    position: relative;
    z-index: 1;
    max-inline-size: 58rem;
  }

  .ad-eyebrow {
    margin: 0;
    color: var(--ad-blue);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ad-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.8rem;
    color: #e4f6ff;
    background: rgb(255 255 255 / 10%);
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .ad-hero__eyebrow::before {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    content: "";
    background: var(--ad-coral);
    border-radius: 50%;
  }

  .ad-hero h1 {
    max-inline-size: 11ch;
    margin: 1.8rem 0 1.2rem;
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(3.3rem, 8vw, 7.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .ad-hero__lead {
    max-inline-size: 56ch;
    margin: 0;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .ad-hero__place {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin: 1.5rem 0 0;
    color: rgb(255 255 255 / 80%);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .ad-hero__place-mark {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    background: #9fdcf7;
    border-radius: 50%;
    box-shadow: 0 0 0 0.25rem rgb(159 220 247 / 18%);
  }

  .ad-hero__folio {
    position: absolute;
    inset-block-end: 2rem;
    inset-inline-end: 2rem;
    color: rgb(255 255 255 / 70%);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    writing-mode: vertical-rl;
  }

  .ad-reading-layout {
    display: grid;
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 7.5rem);
    inline-size: min(100% - 2 * var(--spacing-site-gutter), 78rem);
    margin: clamp(4rem, 8vw, 7.5rem) auto 0;
  }

  .ad-index {
    position: sticky;
    inset-block-start: 6.5rem;
    align-self: start;
    max-block-size: calc(100svh - 7.5rem);
    padding: 1.1rem 0 1rem 1rem;
    overflow: auto;
    border-inline-start: 1px solid var(--ad-rule);
  }

  .ad-index__label {
    margin: 0 0 1rem;
    color: var(--ad-muted);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ad-index ol {
    display: grid;
    gap: 0.2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ad-index a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-block-size: 2.65rem;
    padding: 0.55rem 0.6rem;
    color: var(--ad-muted);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .ad-index a span {
    color: var(--ad-blue);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.06em;
  }

  .ad-index a:hover {
    color: var(--ad-ink);
    background: rgb(21 154 214 / 8%);
  }

  .ad-index a:focus-visible,
  .ad-next__links a:focus-visible {
    outline: 2px solid var(--ad-blue);
    outline-offset: 3px;
  }

  .ad-article {
    min-inline-size: 0;
    background: color-mix(in srgb, var(--ad-paper) 72%, transparent);
    border-radius: 1rem;
  }

  .ad-section {
    padding: clamp(2.7rem, 5.5vw, 5rem) clamp(1.2rem, 4vw, 4rem);
    border-bottom: 1px solid var(--ad-rule);
    scroll-margin-block-start: 7rem;
  }

  .ad-section__heading {
    max-inline-size: 52rem;
    margin-block-end: clamp(1.8rem, 3.5vw, 3rem);
  }

  .ad-section__heading h2,
  .ad-next h2 {
    max-inline-size: 18ch;
    margin: 0.55rem 0 0;
    color: var(--ad-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .ad-section__heading h2:focus,
  .ad-next h2:focus {
    outline: 2px solid var(--color-brand-primary-dark);
    outline-offset: 0.25rem;
  }

  .ad-story__copy {
    max-inline-size: 67ch;
  }

  .ad-story__paragraph {
    margin: 0 0 1.25rem;
    color: var(--ad-muted);
    font-size: 1rem;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .ad-story__paragraph:last-child {
    margin-block-end: 0;
  }

  .ad-story__paragraph--lead {
    color: var(--ad-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    line-height: 1.45;
  }

  .ad-purpose {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ad-purpose__item {
    padding: 0.35rem clamp(1rem, 3.3vw, 3rem) 0.4rem 0;
  }

  .ad-purpose__item + .ad-purpose__item {
    padding-inline: clamp(1rem, 3.3vw, 3rem) 0;
    border-inline-start: 1px solid var(--ad-rule);
  }

  .ad-purpose__label {
    margin: 0 0 0.85rem;
    color: var(--ad-blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ad-purpose__copy {
    max-inline-size: 40ch;
    margin: 0;
    color: var(--ad-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.1vw, 1.65rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .ad-list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--ad-rule);
  }

  .ad-list__item {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem 0 1.5rem;
    border-block-end: 1px solid var(--ad-rule);
  }

  .ad-list__number {
    padding-block-start: 0.2rem;
    color: var(--ad-blue);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .ad-list__item h3 {
    margin: 0;
    color: var(--ad-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .ad-list__item p {
    max-inline-size: 60ch;
    margin: 0.45rem 0 0;
    color: var(--ad-muted);
    font-size: 0.93rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .ad-team {
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--ad-rule);
  }

  .ad-team__person {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 1.5rem;
    gap: 1.1rem;
    align-items: center;
    min-block-size: 6.5rem;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--ad-rule);
  }

  .ad-team__portrait {
    display: grid;
    inline-size: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    place-items: center;
    color: var(--ad-ink);
    background: #e6f2f6;
    border: 1px solid var(--ad-rule);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }

  .ad-team__portrait img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .ad-team__details h3 {
    margin: 0;
    color: var(--ad-ink);
    font-size: 1rem;
    font-weight: 750;
  }

  .ad-team__details p {
    margin: 0.25rem 0 0;
    color: var(--ad-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .ad-team__arrow {
    color: var(--ad-blue);
    font-size: 1rem;
  }

  .ad-next {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(14rem, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(2.4rem, 5vw, 4.5rem) clamp(1.2rem, 4vw, 4rem);
    margin: clamp(2rem, 4vw, 3rem) clamp(1.2rem, 4vw, 4rem) 0;
    color: #fff;
    background: var(--ad-ink);
    border-radius: 1rem;
    scroll-margin-block-start: 7rem;
  }

  .ad-next .ad-eyebrow {
    color: #9fdcf7;
  }

  .ad-next h2 {
    max-inline-size: 15ch;
    margin-block-start: 0.8rem;
    color: #fff;
  }

  .ad-next__copy > p:last-child {
    max-inline-size: 50ch;
    margin: 1rem 0 0;
    color: rgb(255 255 255 / 76%);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .ad-next__links {
    display: grid;
    border-block-start: 1px solid rgb(255 255 255 / 24%);
  }

  .ad-next__links a {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-block-size: 3.1rem;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
    border-block-end: 1px solid rgb(255 255 255 / 24%);
    transition: color 150ms ease, padding-inline 150ms ease;
  }

  .ad-next__links a span {
    color: #9fdcf7;
  }

  .ad-next__links a:hover {
    padding-inline: 0.35rem;
    color: #9fdcf7;
  }

  @media (width <= 62rem) {
    .ad-reading-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      inline-size: min(100% - 2 * var(--spacing-site-gutter), 66rem);
      margin-block-start: 3rem;
    }

    .ad-index {
      position: static;
      max-block-size: none;
      padding: 0;
      overflow: visible;
      border: 0;
    }

    .ad-index__label {
      margin-block-end: 0.65rem;
    }

    .ad-index ol {
      display: flex;
      gap: 0.35rem;
      padding-block-end: 0.4rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: thin;
    }

    .ad-index li {
      flex: none;
    }

    .ad-index a {
      min-block-size: 2.75rem;
      background: color-mix(in srgb, var(--ad-paper) 72%, transparent);
      border: 1px solid var(--ad-rule);
    }

    .ad-article {
      background: transparent;
    }

    .ad-section {
      padding-inline: clamp(1.25rem, 4vw, 3rem);
      background: color-mix(in srgb, var(--ad-paper) 72%, transparent);
    }

    .ad-section:first-child {
      border-radius: 1rem 1rem 0 0;
    }

    .ad-next {
      margin-inline: 0;
    }
  }

  @media (width <= 42rem) {
    .authors-desk {
      padding-block-end: 2rem;
    }

    .ad-hero {
      min-block-size: min(42rem, calc(100svh - 6.5rem));
      padding: 2rem 1.4rem 2.3rem;
      margin-block-start: 0.5rem;
      border-radius: 1.25rem;
    }

    .ad-hero__image {
      object-position: 52% center;
      opacity: 0.62;
    }

    .ad-hero__veil {
      background:
        linear-gradient(90deg, rgb(8 31 48 / 86%), rgb(8 31 48 / 46%)),
        linear-gradient(0deg, rgb(8 31 48 / 88%), transparent 84%);
    }

    .ad-hero h1 {
      max-inline-size: 10ch;
      font-size: clamp(3.2rem, 15vw, 5.8rem);
    }

    .ad-hero__lead {
      max-inline-size: 38ch;
      font-size: 1rem;
    }

    .ad-hero__folio {
      inset-block-end: 1rem;
      inset-inline-end: 1rem;
      font-size: 0.55rem;
    }

    .ad-reading-layout {
      gap: 1rem;
      margin-block-start: 2rem;
    }

    .ad-section {
      padding: 2.5rem 1.15rem;
      scroll-margin-block-start: 6rem;
    }

    .ad-purpose {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .ad-purpose__item,
    .ad-purpose__item + .ad-purpose__item {
      padding: 0;
      border: 0;
    }

    .ad-purpose__item + .ad-purpose__item {
      padding-block-start: 1.5rem;
      border-block-start: 1px solid var(--ad-rule);
    }

    .ad-list__item {
      grid-template-columns: 2.3rem minmax(0, 1fr);
      gap: 0.55rem;
    }

    .ad-team__person {
      grid-template-columns: 3.5rem minmax(0, 1fr) 1rem;
      gap: 0.8rem;
    }

    .ad-team__portrait {
      inline-size: 3.5rem;
    }

    .ad-next {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.8rem;
      padding: 2rem 1.15rem;
      border-radius: 0.8rem;
      scroll-margin-block-start: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ad-index a,
    .ad-next__links a {
      transition: none;
    }
  }
</style>
